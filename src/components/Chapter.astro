---
// One technical chapter of a project page. The detail-view letter (A, B, C…) works
// like a section callout on a drawing sheet.
import { Image } from 'astro:assets';
import { t, ui, type Lang } from '../data/i18n';
import type { Chapter } from '../data/content';
import ModuleMedia from './ModuleMedia.astro';

interface Props { lang: Lang; chapter: Chapter }
const { lang, chapter: c } = Astro.props;
const pics = c.pics ?? [];
---
<section class="ch" id={c.id} aria-labelledby={`${c.id}-title`}>
  <div class:list={["wrap ch-grid", { "with-media": pics.length > 0 || Astro.slots.has("wide") }]} >
    <div class="ch-copy">
    <div class="ch-head">
      <span class="mark" aria-hidden="true">{c.mark}</span>
      <h2 id={`${c.id}-title`} class="display ch-title">{t(c.title, lang)}</h2>
    </div>

    <div class="ch-body">
      {c.lede && <p class="ch-lede">{t(c.lede, lang)}</p>}

      {c.specs && (
        <dl class="specs">
          {c.specs.map((s) => (
            <div>
              <dt>{t(s.label, lang)}{s.note && <span class="note"> {t(s.note, lang)}</span>}</dt>
              <dd><span class="num">{s.value}</span>{s.unit && <span class="num unit">{s.unit}</span>}</dd>
            </div>
          ))}
        </dl>
      )}

      {c.bullets && (
        <ul class="bullets">
          {c.bullets.map((b) => <li>{t(b, lang)}</li>)}
        </ul>
      )}

      <slot />
    </div>
    </div>

  <div class="ch-media">
  {Astro.slots.has('wide') && <div class="wide"><slot name="wide" /></div>}

  {pics.length > 0 && (
    <div>
      <ul class:list={['pics', `n${Math.min(pics.length, 4)}`, { 'has-model': pics.some(p => p.model), 'leading-figure': pics.length === 3 }]}>
        {pics.map((p, i) => (
          <li>
            {p.model ? <ModuleMedia pic={p} lang={lang} /> : (
            <button class:list={['pic', { light: p.light, cutout: p.cutout }]} type="button" data-zoom={p.src.src} data-alt={t(p.alt, lang)} aria-label={`${t(ui.enlarge, lang)}: ${t(p.alt, lang)}`}>
              <Image src={p.src} alt={t(p.alt, lang)} widths={[480, 900, 1400, 2400]} sizes={pics.length === 1 || (i === 0 && pics.length % 2 === 1) ? '100vw' : '(max-width: 560px) 100vw, 50vw'} />
              <span class="cap"><span class="num">{c.mark}{i + 1}</span> {t(p.alt, lang)}</span>
            </button>
            )}
          </li>
        ))}
      </ul>
    </div>
  )}
  </div>
  </div>
  {Astro.slots.has('after-media') && <div class="wrap wide"><slot name="after-media" /></div>}
</section>

<style>
  .ch { padding-top: clamp(3.5rem, 6vw, 5.5rem); scroll-margin-top: 80px; }
  .ch-grid {
    display: grid;
    grid-template-columns: minmax(0, .85fr) minmax(0, 1.15fr);
    align-items: start;
    gap: clamp(1.5rem, 4vw, 3.5rem);
    padding-top: 2rem;
    position: relative;
  }
  .ch-copy { display: grid; gap: 1.5rem; min-width: 0; }
  .ch-media { min-width: 0; display: grid; gap: 1rem; }
  .ch-grid:not(.with-media) { grid-template-columns: 1fr; }
  .ch-grid:not(.with-media) .ch-copy { grid-template-columns: minmax(0, .85fr) minmax(0, 1.15fr); gap: 3rem; }
  .ch-media .wide, .ch-media .pics { margin-top: 0; }
  .ch-media :global(.media-view) { height: clamp(300px, 29vw, 410px); }
  .ch-grid::before { content: ''; position: absolute; top: 0; left: var(--gutter); right: var(--gutter); height: 1px; background: var(--rule); }
  .ch-head {
    position: static;
    top: 90px;
    align-self: start;
    display: grid;
    grid-template-columns: 2.5rem minmax(0, 1fr);
    gap: 1rem;
  }
  .mark {
    display: block;
    font-family: var(--f-latin);
    font-weight: 700;
    font-size: 2.4rem;
    line-height: .85;
    letter-spacing: -.05em;
    color: var(--amber);
  }
  .ch-title { font-size: clamp(1.9rem, 2.6vw, 2.7rem); line-height: 1.08; text-wrap: balance; }
  .ch-body { display: grid; gap: 1.2rem; padding-top: .15rem; }
  .ch-lede { font-size: clamp(1.1rem, 1.4vw, 1.3rem); line-height: 1.65; color: var(--ink); max-width: 42ch; }

  .specs {
    display: flex;
    flex-wrap: wrap;
    margin: 0;
    gap: 1.25rem 2.5rem;
  }
  .specs div { padding: 0; }
  .specs dt { font-size: var(--t-xs); color: var(--ink-3); }
  .note { color: var(--ink-3); }
  .specs dd { margin: 0.25rem 0 0; font-size: var(--t-2xl); line-height: 1; color: var(--amber); }
  .unit { font-size: 0.5em; color: var(--ink-2); margin-left: 0.25em; }

  .bullets {
    margin: 0;
    padding: 0;
    list-style: none;
    display: grid;
    gap: .7rem;
    color: var(--ink-2);
  }
  .bullets li {
    position: relative;
    padding-left: 1.3rem;
    max-width: 68ch;
  }
  .bullets li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.72em;
    width: .35rem;
    height: .35rem;
    background: var(--amber);
  }

  .wide { margin-top: 1.75rem; display: grid; gap: 1.5rem; }

  .pics {
    list-style: none;
    margin: 1.75rem 0 0;
    padding: 0;
    display: grid;
    gap: 1rem;
    grid-template-columns: repeat(var(--cols, 2), minmax(0, 1fr));
  }
  .pics.n1 { --cols: 1; }
  .pics.n4 { --cols: 2; }
  .pics.n2 { --cols: 2; }
  .pics.n3 { --cols: 2; }
  .pics.leading-figure > li:first-child { grid-column: 1 / -1; }
  .pics li { min-width: 0; }
  .pics.has-model { --cols: 1; gap: 1.5rem; }
  .pic {
    display: grid;
    width: 100%;
    padding: 0;
    border: 0;
    background: #04070c;
    color: inherit;
    font: inherit;
    text-align: left;
    cursor: zoom-in;
  }
  .pic.light { background: var(--plate); }
  .pics.n1 .pic :global(img), .pics.leading-figure > li:first-child .pic :global(img) { aspect-ratio: 16 / 9; }
  .pic :global(img) {
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: contain;
  }
  .pic.light :global(img) { padding: 2%; mix-blend-mode: multiply; }
  .cap {
    padding: .8rem 0;
    font-size: var(--t-xs);
    color: var(--ink-2);
    background: var(--ground);
  }
  .cap .num { color: var(--amber); }
  .pic:hover .cap { color: var(--ink); }

  @media (max-width: 900px) {
    .ch-grid, .ch-grid:not(.with-media) .ch-copy { grid-template-columns: 1fr; gap: 1.8rem; }
    .ch-head { position: static; display: grid; grid-template-columns: auto minmax(0, 1fr); gap: 1.25rem; align-items: start; }
    .mark { font-size: 2.25rem; }
    .pics.n4 { --cols: 2; }
    .ch-title { font-size: clamp(1.8rem, 4vw, 2.5rem); }
    .pics { gap: 1.5rem; }
  }
  @media (max-width: 560px) {
    .pics { --cols: 1 !important; }
    .pics.n1 :global(.media-view), .pics.leading-figure > li:first-child :global(.media-view) { aspect-ratio: auto; width: 100%; }
    .pics.n1 .pic :global(img), .pics.leading-figure > li:first-child .pic :global(img) { aspect-ratio: 4 / 3; }
    .ch-head { gap: 1rem; }
  }
</style>
