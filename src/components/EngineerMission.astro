---
import {missionFilm as copy, engineerShowcase} from '../data/content';
import {t,type Lang} from '../data/i18n';
import timing from '../../materials/models/derived/rm2025-field/models/mission-timing.json';
interface Props{lang:Lang;concise?:boolean}
const {lang,concise=false}=Astro.props;
const base=import.meta.env.BASE_URL;
const times=timing.chapters;
---
<figure class="mission-film" data-mission-film>
  <div class="mission-frame">
    <video src={`${base}video/engineer-mission-${lang}.mp4`} poster={`${base}video/engineer-mission-${lang}.jpg`} aria-label={t(copy.alt,lang)} muted loop playsinline preload="metadata" controls></video>
    <button class="mission-start" type="button" data-mission-start>{t(copy.play,lang)}</button>
  </div>
  <nav class="mission-chapters" aria-label={t(copy.title,lang)}>
    {copy.phases.filter((_,i)=>[0,1,2,4,6].includes(i)).map(phase=>{
      const i=copy.phases.indexOf(phase);
      return <button type="button" data-mission-time={times[i]}><span class="idx" aria-hidden="true">{`${Math.floor(times[i]/60)}:${String(Math.floor(times[i]%60)).padStart(2,'0')}`}</span>{t(phase,lang)}</button>;
    })}
  </nav>
  <figcaption>{t(concise?engineerShowcase.missionNote:copy.caption,lang)}</figcaption>
</figure>

<script>
  document.querySelectorAll<HTMLElement>('[data-mission-film]').forEach(root=>{
    const video=root.querySelector('video')!;
    const start=root.querySelector<HTMLButtonElement>('[data-mission-start]')!;
    const reduced=matchMedia('(prefers-reduced-motion: reduce)');
    let visible=false,manual=false,userPaused=false,observerPause=false;
    const play=()=>video.play().then(()=>{start.hidden=true;}).catch(()=>{start.hidden=false;});
    start.addEventListener('click',()=>{manual=true;userPaused=false;void play();});
    root.querySelectorAll<HTMLButtonElement>('[data-mission-time]').forEach(button=>button.addEventListener('click',()=>{video.currentTime=Number(button.dataset.missionTime);manual=true;userPaused=false;void play();}));
    video.addEventListener('play',()=>{start.hidden=true;userPaused=false;});
    video.addEventListener('pause',()=>{if(!observerPause&&visible)userPaused=true;observerPause=false;});
    const pause=()=>{if(!video.paused){observerPause=true;video.pause();}};
    new IntersectionObserver(([entry])=>{visible=entry.isIntersecting;if(!visible)pause();else if(!userPaused&&(!reduced.matches||manual)&&!document.hidden)void play();},{threshold:.2}).observe(root);
    document.addEventListener('visibilitychange',()=>{if(document.hidden)pause();else if(visible&&!userPaused&&(!reduced.matches||manual))void play();});
    reduced.addEventListener('change',()=>{if(reduced.matches){manual=false;pause();start.hidden=false;}else if(visible&&!userPaused)void play();});
    if(!reduced.matches)start.hidden=true;
  });
</script>

<style>
  .mission-film{margin:.5rem 0 0;background:var(--ground)}
  .mission-frame{position:relative;aspect-ratio:16/9;background:#070d17;overflow:hidden}
  video{display:block;width:100%;height:100%;object-fit:contain}
  .mission-start{position:absolute;left:50%;top:50%;transform:translate(-50%,-50%);padding:.75rem 1.4rem;border:1px solid var(--amber);color:var(--amber);background:rgba(7,13,23,.85);font:inherit;cursor:pointer}
  .mission-start[hidden]{display:none}
  /* Chapter jumps as a timecoded timeline, same idiom as chapter B. */
  .mission-chapters{display:flex;border-top:1px solid var(--rule)}
  .mission-chapters button{flex:1;display:grid;gap:.15rem;justify-items:start;font:inherit;font-size:var(--t-xs);text-align:left;color:var(--ink-2);background:transparent;border:0;border-top:2px solid transparent;margin-top:-1px;padding:.6rem .6rem .5rem 0;cursor:pointer;transition:color .15s,border-color .15s}
  .mission-chapters .idx{font:10px var(--f-mono);color:var(--ink-3);letter-spacing:.06em}
  .mission-chapters button:hover{color:var(--ink);border-top-color:var(--amber)}
  .mission-chapters button:hover .idx{color:var(--amber)}
  button:focus-visible{outline:2px solid var(--amber);outline-offset:4px}
  figcaption{margin:0;padding:.2rem 0 0;color:var(--ink-3);font-size:var(--t-xs);line-height:1.7;max-width:80ch}
  @media(max-width:760px){.mission-chapters{overflow-x:auto}.mission-chapters button{min-width:76px;font-size:.65rem}.mission-start{font-size:var(--t-xs)}}
</style>
