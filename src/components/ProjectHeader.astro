---
// Project page opener: big robot ID plate, title, lede, and a drawing title block.
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';
import { t, type Lang, type T } from '../data/i18n';
import { pageCopy } from '../data/content';
import type { Pic, Stat, TitleRow } from '../data/content';

interface Props {
  lang: Lang;
  drawing: string;
  robotNo?: string | null;
  title: T;
  lede: T;
  cover: Pic;
  titleBlock?: TitleRow[];
  stats?: Stat[];
  statsSource?: T;
  lines?: ImageMetadata;
}
const { lang, drawing, robotNo, title, lede, cover, titleBlock = [], stats = [], statsSource, lines } = Astro.props;
---
<header class="ph" data-ph>
  <div class="wrap ph-grid">
    <div class="ph-copy">
      <span class="dwg num">{drawing}</span>
      <h1 class="display title">{t(title, lang)}</h1>
      <p class="lede">{t(lede, lang)}</p>
    </div>

    <figure class:list={['ph-pic', { light: cover.light }]}>
      <Image class="ph-photo" src={cover.src} alt={t(cover.alt, lang)} widths={[720, 1200, 1620, 2400]} sizes="(max-width: 900px) 100vw, 58vw" loading="eager" />
      {lines && <Image class="ph-lines" src={lines} alt="" aria-hidden="true" widths={[720, 1200]} sizes="(max-width: 900px) 100vw, 58vw" loading="eager" />}
      {robotNo && (
        <div class="plate" aria-hidden="true">
          <span class="bar"></span><span class="num plate-no">{robotNo}</span><span class="bar"></span>
        </div>
      )}
    </figure>
  </div>

  {titleBlock.length > 0 && (
    <div class="wrap">
      <dl class="tb">
        {titleBlock.map((r) => (
          <div class="tb-cell"><dt>{t(r.label, lang)}</dt><dd>{t(r.value, lang)}</dd></div>
        ))}
        <div class="tb-cell"><dt>{t(pageCopy.drawing, lang)}</dt><dd class="num">{drawing}</dd></div>
      </dl>
    </div>
  )}

  {stats.length > 0 && (
    <div class="wrap">
      <ul class="stats">
        {stats.map((s) => (
          <li>
            <span class="num v">{s.value}{s.unit && <span class="u">{s.unit}</span>}</span>
            <span class="l">{t(s.label, lang)}</span>
            {s.rank && <span class="num rank">{s.rank}</span>}
          </li>
        ))}
      </ul>
      {statsSource && <p class="stats-src">{t(statsSource, lang)}</p>}
    </div>
  )}
</header>

<script>
  import { gsap, reducedMotion } from '../scripts/smooth';
  const root = document.querySelector<HTMLElement>('[data-ph]');
  const linesEl = root?.querySelector<HTMLElement>('.ph-lines');
  if (root && linesEl && !reducedMotion) {
    const s = { p: 0 };
    gsap.to(s, {
      p: 100, duration: 1.6, delay: 0.2, ease: 'power2.inOut',
      onUpdate: () => root.style.setProperty('--reveal', `${s.p}%`),
    });
  } else root?.style.setProperty('--reveal', '100%');
</script>

<style>
  .ph { --reveal: 0%; padding-top: clamp(7.5rem, 12vw, 10rem); }
  .ph-grid {
    display: grid;
    grid-template-columns: minmax(0, .86fr) minmax(0, 1.14fr);
    gap: clamp(2rem, 4vw, 4rem);
    align-items: center;
  }
  .ph-copy { display: grid; gap: 1.8rem; padding: 2rem 0; position: relative; z-index: 1; }
  .dwg { font-size: var(--t-sm); color: var(--amber); letter-spacing: .02em; display: flex; align-items: center; gap: .9rem; }
  .dwg::before { content: ''; width: 2.4rem; height: 3px; background: var(--amber); }
  .title { font-size: clamp(3.5rem, 6.6vw, 6.3rem); line-height: .98; letter-spacing: -.035em; text-wrap: balance; }
  .lede { color: var(--ink-2); font-size: clamp(1.05rem, 1.45vw, 1.25rem); line-height: 1.8; max-width: 42ch; }

  .ph-pic {
    position: relative;
    margin: 0;
    aspect-ratio: 1 / 1;
    overflow: hidden;
    background: #04070c;
  }
  .ph-pic.light {
    background: var(--plate);
  }
  .ph-pic :global(img) { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: contain; }
  .ph-pic.light :global(img) { object-fit: contain; padding: 3%; }
  .ph-pic.light :global(.ph-photo) { mix-blend-mode: multiply; }
  .ph-pic :global(.ph-photo) { clip-path: inset(0 calc(100% - var(--reveal)) 0 0); }
  .ph-pic :global(.ph-lines) { clip-path: inset(0 0 0 var(--reveal)); }

  .plate {
    position: absolute;
    right: 1.4rem;
    bottom: 1.4rem;
    display: flex;
    align-items: center;
    gap: 0.6rem;
  }
  .plate-no {
    font-family: var(--f-latin);
    font-weight: 700;
    font-size: clamp(4rem, 7vw, 6.5rem);
    line-height: 1;
    color: var(--ink);
  }
  .ph-pic.light .plate-no { color: var(--ground); }
  .bar {
    width: 6px;
    height: 4.2rem;
    background: var(--blue);
    box-shadow: 0 0 14px 2px rgba(61, 139, 255, 0.7);
  }

  .tb {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
    margin: 2.5rem 0 0;
    padding-top: 1.3rem;
    gap: 1.25rem 2rem;
    border-top: 1px solid var(--rule);
  }
  .tb-cell {
    padding: 0;
  }
  .tb dt { font-size: var(--t-xs); color: var(--ink-3); }
  .tb dd { margin: .3rem 0 0; font-size: var(--t-sm); color: var(--ink-2); }

  .stats {
    list-style: none;
    margin: 3rem 0 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(190px, 1fr));
    gap: 2rem;
  }
  .stats li {
    position: relative;
    display: grid;
    gap: .65rem;
    padding: 1rem 0 0;
    border-top: 2px solid var(--rule);
  }
  .v { font-family: var(--f-latin); font-size: clamp(2.5rem, 4vw, 3.8rem); font-weight: 600; letter-spacing: -.04em; line-height: 1; color: var(--ink); }
  .stats li:first-child { border-top-color: var(--amber); }
  .stats li:first-child .v { color: var(--amber); }
  .u { font-size: 0.5em; color: var(--ink-2); margin-left: 0.2em; }
  .l { font-size: var(--t-sm); color: var(--ink-2); }
  .rank {
    position: absolute;
    top: -.85rem;
    right: 0;
    padding-left: .5rem;
    background: var(--ground);
    font-size: var(--t-xs);
    color: var(--amber);
  }
  .stats-src { margin-top: 0.8rem; font-size: var(--t-xs); color: var(--ink-3); }

  @media (max-width: 900px) {
    .ph-grid { grid-template-columns: 1fr; gap: 2rem; }
    .ph-copy { padding: 0; gap: 1.25rem; }
    .title { font-size: clamp(3.2rem, 10vw, 5.5rem); max-width: 13ch; }
    .ph-pic { aspect-ratio: 4 / 3; }
    .lede { max-width: 60ch; }
    .stats { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 2rem 1.25rem; }
    .v { font-size: clamp(2rem, 6vw, 3rem); }
    .tb { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
</style>
