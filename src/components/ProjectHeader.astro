---
// Project page opener: big robot ID plate, title, lede, and a drawing title block.
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';
import { t, type Lang, type T } from '../data/i18n';
import type { Pic, Stat, TitleRow } from '../data/content';

interface Props {
  lang: Lang;
  drawing: string;
  robotNo?: string | null;
  title: T;
  lede: T;
  cover: Pic;
  titleBlock?: TitleRow[];
  stats?: Stat[];
  statsSource?: T;
  lines?: ImageMetadata;
}
const { lang, drawing, robotNo, title, lede, cover, titleBlock = [], stats = [], statsSource, lines } = Astro.props;
---
<header class="ph" data-ph>
  <div class="wrap ph-grid">
    <div class="ph-copy">
      <span class="dwg num">{drawing}</span>
      <h1 class="display title">{t(title, lang)}</h1>
      <p class="lede">{t(lede, lang)}</p>
    </div>

    <figure class:list={['ph-pic', { light: cover.light }]}>
      <Image class="ph-photo" src={cover.src} alt={t(cover.alt, lang)} widths={[720, 1200, 1620]} sizes="(max-width: 900px) 100vw, 58vw" loading="eager" />
      {lines && <Image class="ph-lines" src={lines} alt="" aria-hidden="true" widths={[720, 1200]} sizes="(max-width: 900px) 100vw, 58vw" loading="eager" />}
      {robotNo && (
        <div class="plate" aria-hidden="true">
          <span class="bar"></span><span class="num plate-no">{robotNo}</span><span class="bar"></span>
        </div>
      )}
    </figure>
  </div>

  {titleBlock.length > 0 && (
    <div class="wrap">
      <dl class="tb">
        {titleBlock.map((r) => (
          <div class="tb-cell"><dt>{t(r.label, lang)}</dt><dd>{t(r.value, lang)}</dd></div>
        ))}
        <div class="tb-cell"><dt>{lang === 'zh' ? '图号' : 'Drawing'}</dt><dd class="num">{drawing}</dd></div>
      </dl>
    </div>
  )}

  {stats.length > 0 && (
    <div class="wrap">
      <ul class="stats">
        {stats.map((s) => (
          <li>
            <span class="num v">{s.value}{s.unit && <span class="u">{s.unit}</span>}</span>
            <span class="l">{t(s.label, lang)}</span>
            {s.rank && <span class="num rank">{s.rank}</span>}
          </li>
        ))}
      </ul>
      {statsSource && <p class="stats-src">{t(statsSource, lang)}</p>}
    </div>
  )}
</header>

<script>
  import { gsap, reducedMotion } from '../scripts/smooth';
  const root = document.querySelector<HTMLElement>('[data-ph]');
  const linesEl = root?.querySelector<HTMLElement>('.ph-lines');
  if (root && linesEl && !reducedMotion) {
    const s = { p: 0 };
    gsap.to(s, {
      p: 100, duration: 1.6, delay: 0.2, ease: 'power2.inOut',
      onUpdate: () => root.style.setProperty('--reveal', `${s.p}%`),
    });
  } else root?.style.setProperty('--reveal', '100%');
</script>

<style>
  .ph { --reveal: 0%; padding-top: 7.5rem; }
  .ph-grid {
    display: grid;
    grid-template-columns: minmax(0, 0.85fr) minmax(0, 1.15fr);
    gap: clamp(2rem, 5vw, 4rem);
    align-items: end;
  }
  .ph-copy { display: grid; gap: 1.1rem; padding-bottom: 1rem; }
  .dwg { font-size: var(--t-sm); color: var(--amber); letter-spacing: 0.08em; }
  .title { font-size: clamp(2.6rem, 5.4vw, 4.6rem); }
  .lede { color: var(--ink-2); font-size: var(--t-lg); line-height: 1.6; }

  .ph-pic {
    position: relative;
    margin: 0;
    aspect-ratio: 3 / 2;
    overflow: hidden;
    background: #04070c;
  }
  .ph-pic.light { background: var(--plate); }
  .ph-pic :global(img) { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  .ph-pic.light :global(img) { object-fit: contain; padding: 5%; }
  .ph-pic :global(.ph-photo) { clip-path: inset(0 calc(100% - var(--reveal)) 0 0); }
  .ph-pic :global(.ph-lines) { clip-path: inset(0 0 0 var(--reveal)); }

  .plate {
    position: absolute;
    right: 1.2rem;
    bottom: 1rem;
    display: flex;
    align-items: center;
    gap: 0.6rem;
  }
  .plate-no {
    font-family: var(--f-latin);
    font-weight: 700;
    font-size: 5.5rem;
    line-height: 1;
    color: var(--ink);
  }
  .ph-pic.light .plate-no { color: var(--ground); }
  .bar {
    width: 6px;
    height: 4.2rem;
    background: var(--blue);
    box-shadow: 0 0 14px 2px rgba(61, 139, 255, 0.7);
  }

  .tb {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
    margin: 2.5rem 0 0;
    border: 1px solid var(--rule);
  }
  .tb-cell {
    padding: 0.8rem 1rem;
    border-right: 1px solid var(--rule);
    border-bottom: 1px solid var(--rule);
    margin: 0 -1px -1px 0;
  }
  .tb dt { font-size: var(--t-xs); color: var(--ink-3); }
  .tb dd { margin: 0.2rem 0 0; font-size: var(--t-sm); }

  .stats {
    list-style: none;
    margin: 3.5rem 0 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(170px, 1fr));
    gap: 1px;
    background: var(--rule);
    border: 1px solid var(--rule);
  }
  .stats li {
    position: relative;
    display: grid;
    gap: 0.4rem;
    padding: 1.3rem 1.2rem 1.2rem;
    background: var(--ground);
  }
  .v { font-size: var(--t-2xl); line-height: 1; color: var(--ink); }
  .stats li:first-child .v { color: var(--amber); }
  .u { font-size: 0.5em; color: var(--ink-2); margin-left: 0.2em; }
  .l { font-size: var(--t-sm); color: var(--ink-2); }
  .rank {
    position: absolute;
    top: 0.8rem;
    right: 0.9rem;
    font-size: var(--t-xs);
    color: var(--amber);
  }
  .stats-src { margin-top: 0.8rem; font-size: var(--t-xs); color: var(--ink-3); }

  @media (max-width: 900px) {
    .ph-grid { grid-template-columns: 1fr; }
  }
</style>
