---
// Project page opener: big robot ID plate, title, lede, and a drawing title block.
import type { ImageMetadata } from 'astro';
import ModuleMedia from './ModuleMedia.astro';
import { Image } from 'astro:assets';
import { t, type Lang, type T } from '../data/i18n';
import { pageCopy } from '../data/content';
import type { Pic, Stat, TitleRow } from '../data/content';

interface Props {
  lang: Lang;
  drawing: string;
  robotNo?: string | null;
  title: T;
  lede: T;
  cover: Pic;
  titleBlock?: TitleRow[];
  stats?: Stat[];
  statsSource?: T;
  lines?: ImageMetadata;
}
const { lang, drawing, robotNo, title, lede, cover, titleBlock = [], stats = [], statsSource, lines } = Astro.props;
---
<header class="ph" data-ph>
  <div class="wrap ph-grid">
    <div class="ph-copy">
      <span class="dwg num">{drawing}</span>
      <h1 class="display title">{t(title, lang)}</h1>
      <p class="lede">{t(lede, lang)}</p>
    </div>

    <div class="ph-visual">
      {cover.model ? <ModuleMedia pic={cover} lang={lang} /> : (
        <figure class:list={['ph-pic', { light: cover.light, cutout: cover.cutout }]}>
          <Image src={cover.src} alt={t(cover.alt, lang)} widths={[720, 1200, 1620, 2400]} sizes="(max-width: 900px) 100vw, 58vw" loading="eager" />
        </figure>
      )}
    </div>
  </div>

  {titleBlock.length > 0 && (
    <div class="wrap">
      <dl class="tb">
        {titleBlock.map((r) => (
          <div class="tb-cell"><dt>{t(r.label, lang)}</dt><dd>{t(r.value, lang)}</dd></div>
        ))}
        <div class="tb-cell"><dt>{t(pageCopy.drawing, lang)}</dt><dd class="num">{drawing}</dd></div>
      </dl>
    </div>
  )}

  {stats.length > 0 && (
    <div class="wrap">
      <ul class="stats">
        {stats.map((s) => (
          <li>
            <span class="num v">{s.value}{s.unit && <span class="u">{s.unit}</span>}</span>
            <span class="l">{t(s.label, lang)}</span>
            {s.rank && <span class="num rank">{s.rank}</span>}
          </li>
        ))}
      </ul>
      {statsSource && <p class="stats-src">{t(statsSource, lang)}</p>}
    </div>
  )}
</header>

<style>
  .ph { padding-top: clamp(7rem, 9vw, 8.5rem); }
  .ph-grid {
    display: grid;
    grid-template-columns: minmax(0, .78fr) minmax(0, 1.22fr);
    gap: clamp(1.5rem, 3vw, 3rem);
    align-items: center;
  }
  .ph-copy { display: grid; gap: 1.8rem; padding: 2rem 0; position: relative; z-index: 1; }
  .dwg { font-size: var(--t-sm); color: var(--amber); letter-spacing: .02em; display: flex; align-items: center; gap: .9rem; }
  .dwg::before { content: ''; width: 2.4rem; height: 3px; background: var(--amber); }
  .title { font-size: clamp(2.8rem, 4.8vw, 4.8rem); line-height: .98; letter-spacing: -.035em; text-wrap: balance; }
  .lede { color: var(--ink-2); font-size: clamp(1.05rem, 1.45vw, 1.25rem); line-height: 1.8; max-width: 42ch; }

  .ph-pic {
    position: relative;
    margin: 0;
    aspect-ratio: 5 / 4;
    overflow: hidden;
    background: #04070c;
  }
  .ph-pic.light {
    background: linear-gradient(145deg, #b8c5d0, #899dae);
  }
  .ph-pic :global(img) { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: contain; }
  .ph-pic.light :global(img) { object-fit: contain; padding: 3%; }
  .ph-pic.light :global(img) { mix-blend-mode: multiply; filter: saturate(.6) contrast(1.04); }



  .plate {
    position: absolute;
    right: 1.4rem;
    bottom: 1.4rem;
    display: flex;
    align-items: center;
    gap: 0.6rem;
  }
  .plate-no {
    font-family: var(--f-latin);
    font-weight: 700;
    font-size: clamp(4rem, 7vw, 6.5rem);
    line-height: 1;
    color: var(--ink);
  }
  .ph-pic.light .plate-no { color: var(--ground); }
  .bar {
    width: 6px;
    height: 4.2rem;
    background: var(--blue);
    box-shadow: 0 0 14px 2px rgba(61, 139, 255, 0.7);
  }

  .ph-visual { min-width: 0; }
  .ph-visual :global(.module-media) { background: transparent; }
  .ph-visual :global(.media-view) { height: clamp(340px, 37vw, 500px); }
  .ph-visual :global(figcaption) { display: none; }
  .ph-visual :global(.controls) { padding: .75rem 0; }
  .ph-visual :global(.controls > span) { display: none; }
  .tb {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
    margin: 2.5rem 0 0;
    padding-top: 1.3rem;
    gap: 1.25rem 2rem;
    border-top: 1px solid var(--rule);
  }
  .tb-cell {
    padding: 0;
  }
  .tb dt { font-size: var(--t-xs); color: var(--ink-3); }
  .tb dd { margin: .3rem 0 0; font-size: var(--t-sm); color: var(--ink-2); }

  .stats {
    list-style: none;
    margin: 1.75rem 0 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(190px, 1fr));
    gap: 1.5rem;
  }
  .stats li {
    position: relative;
    display: grid;
    gap: .65rem;
    padding: 1rem 0 0;
    border-top: 2px solid var(--rule);
  }
  .v { font-family: var(--f-latin); font-size: clamp(2rem, 3vw, 3rem); font-weight: 600; letter-spacing: -.04em; line-height: 1; color: var(--ink); }
  .stats li:first-child { border-top-color: var(--amber); }
  .stats li:first-child .v { color: var(--amber); }
  .u { font-size: 0.5em; color: var(--ink-2); margin-left: 0.2em; }
  .l { font-size: var(--t-sm); color: var(--ink-2); }
  .rank {
    position: absolute;
    top: -.85rem;
    right: 0;
    padding-left: .5rem;
    background: var(--ground);
    font-size: var(--t-xs);
    color: var(--amber);
  }
  .stats-src { margin-top: 0.8rem; font-size: var(--t-xs); color: var(--ink-3); }

  @media (max-width: 900px) {
    .ph-grid { grid-template-columns: 1fr; gap: 2rem; }
    .ph-copy { padding: 0; gap: 1.25rem; }
    .title { font-size: clamp(2.5rem, 8vw, 4rem); max-width: 13ch; }
    .ph-pic { aspect-ratio: 4 / 3; }
    .lede { max-width: 60ch; }
    .stats { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 2rem 1.25rem; }
    .v { font-size: clamp(2rem, 6vw, 3rem); }
    .ph-visual { min-width: 0; }
  .ph-visual :global(.module-media) { background: transparent; }
  .ph-visual :global(.media-view) { height: clamp(340px, 37vw, 500px); }
  .ph-visual :global(figcaption) { display: none; }
  .ph-visual :global(.controls) { padding: .75rem 0; }
  .ph-visual :global(.controls > span) { display: none; }
  .tb { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
</style>
