---
// The 5.8 s exchange: match footage loop with a HUD timer synced to the clip.
// The clip is cut so the exchange starts at `data-t0` seconds into the file.
import { existsSync } from 'node:fs';
import { join } from 'node:path';
import { Image } from 'astro:assets';
import { record } from '../data/content';
import { t, ui, type Lang } from '../data/i18n';

interface Props { lang: Lang; compact?: boolean }
const { lang, compact = false } = Astro.props;

const clip = 'video/exchange-58.mp4';
const poster = 'video/exchange-58.jpg';
// builds run from the project root; import.meta.url points into the bundle, not src/
const hasClip = existsSync(join(process.cwd(), 'public', clip));
const base = import.meta.env.BASE_URL;
// seconds into the clip where the exchange starts (set when the clip is cut)
const T0 = 1.0;
---
<section class:list={['record', { compact }]} data-record aria-labelledby="record-title">
  <div class="wrap grid">
    <div class="screen panel">
      {hasClip ? (
        <video
          class="clip"
          src={base + clip}
          poster={base + poster}
          muted
          playsinline
          loop
          preload="metadata"
          data-t0={T0}
          aria-label={t(record.title, lang)}
        ></video>
      ) : (
        <Image class="clip still" src={record.broadcast.src} alt={t(record.broadcast.alt, lang)} widths={[844]} />
      )}
      <div class="hud" aria-hidden="true">
        <span class="hud-tag latin">LV.4 EXCHANGE</span>
        <span class="hud-timer num" data-timer>{hasClip ? '0.0' : record.value}</span>
        <span class="hud-unit num">s</span>
      </div>
      <span class="corner tl"></span><span class="corner br"></span>
    </div>

    <div class="text">
      <p class="big num" aria-hidden="true">{record.value}<span>s</span></p>
      <h2 id="record-title" class="display title">{t(record.title, lang)}</h2>
      <p class="lede">{t(record.lede, lang)}</p>
      <dl class="crew">
        {record.crew.map((c) => (
          <div><dt>{t(c.label, lang)}</dt><dd>{t(c.value, lang)}</dd></div>
        ))}
        <div><dt>{lang === 'zh' ? '场次' : 'Match'}</dt><dd>{t(record.match, lang)}</dd></div>
      </dl>
      <a class="src" href={record.source} rel="noopener">{t(ui.watchSource, lang)}</a>
    </div>
  </div>
</section>

<script>
  import { reducedMotion } from '../scripts/smooth';

  document.querySelectorAll<HTMLElement>('[data-record]').forEach((root) => {
    const video = root.querySelector<HTMLVideoElement>('video');
    const timer = root.querySelector<HTMLElement>('[data-timer]');
    if (!video || !timer) return;
    const t0 = parseFloat(video.dataset.t0 || '0');

    const tick = () => {
      const v = Math.min(Math.max(video.currentTime - t0, 0), 5.8);
      timer.textContent = v.toFixed(1);
      root.classList.toggle('done', v >= 5.8);
      if (!video.paused) requestAnimationFrame(tick);
    };
    video.addEventListener('play', () => requestAnimationFrame(tick));

    if (reducedMotion) {
      video.removeAttribute('loop');
      timer.textContent = '5.8';
      return;
    }
    // play only while on screen
    new IntersectionObserver(([e]) => {
      if (e.isIntersecting) video.play().catch(() => {});
      else video.pause();
    }, { threshold: 0.35 }).observe(video);
  });
</script>

<style>
  .record { padding: 7rem 0; }
  .record.compact { padding: 3rem 0; }
  .grid {
    display: grid;
    grid-template-columns: minmax(0, 1.35fr) minmax(0, 1fr);
    gap: clamp(2rem, 5vw, 4.5rem);
    align-items: center;
  }
  .screen {
    position: relative;
    aspect-ratio: 16 / 9;
    background: #000;
  }
  .clip {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .clip.still { object-fit: contain; background: #0a0f18; }
  .hud {
    position: absolute;
    left: 1.2rem;
    bottom: 1rem;
    display: grid;
    grid-template-columns: auto auto;
    align-items: baseline;
    column-gap: 0.35rem;
    padding: 0.6rem 0.9rem 0.5rem;
    background: rgba(7, 13, 23, 0.78);
    border-left: 3px solid var(--amber);
  }
  .hud-tag {
    grid-column: 1 / -1;
    font-size: var(--t-xs);
    letter-spacing: 0.1em;
    color: var(--ink-2);
  }
  .hud-timer {
    font-size: var(--t-2xl);
    line-height: 1.1;
    color: var(--ink);
    min-width: 3.2ch;
  }
  .record.done .hud-timer { color: var(--amber); }
  .hud-unit { color: var(--ink-2); }
  .corner {
    position: absolute;
    width: 22px;
    height: 22px;
    border: 2px solid var(--amber);
    pointer-events: none;
  }
  .corner.tl { top: 10px; left: 10px; border-right: 0; border-bottom: 0; }
  .corner.br { bottom: 10px; right: 10px; border-left: 0; border-top: 0; }

  .text { display: grid; gap: 1rem; }
  .big {
    font-size: clamp(5rem, 11vw, 9rem);
    line-height: 0.9;
    color: var(--amber);
    letter-spacing: -0.03em;
  }
  .big span { font-size: 0.35em; color: var(--ink-2); margin-left: 0.15em; }
  .title { font-size: var(--t-2xl); }
  .lede { color: var(--ink-2); }
  .crew {
    display: grid;
    gap: 0.5rem;
    margin: 0.5rem 0 0;
    padding-top: 1rem;
    border-top: 1px solid var(--rule);
  }
  .crew div { display: grid; grid-template-columns: 7rem 1fr; gap: 1rem; }
  .crew dt { color: var(--ink-3); font-size: var(--t-sm); }
  .crew dd { margin: 0; font-size: var(--t-sm); }
  .src {
    justify-self: start;
    font-size: var(--t-sm);
    color: var(--amber);
    text-underline-offset: 4px;
  }

  @media (max-width: 900px) {
    .grid { grid-template-columns: 1fr; }
  }
</style>
