---
// Continuous real-time operator footage, then the official WR result.
// 5.8 s is the broadcast result, not a stopwatch inferred from camera cuts.
import { existsSync } from 'node:fs';
import { join } from 'node:path';
import { Image } from 'astro:assets';
import { record } from '../data/content';
import { t, ui, type Lang } from '../data/i18n';

interface Props { lang: Lang; compact?: boolean }
const { lang, compact = false } = Astro.props;

const clip = 'video/exchange-58.mp4';
const poster = 'video/exchange-58.jpg';
// builds run from the project root; import.meta.url points into the bundle, not src/
const hasClip = existsSync(join(process.cwd(), 'public', clip));
const base = import.meta.env.BASE_URL;
---
<section class:list={['record', { compact }]} data-record aria-labelledby="record-title">
  <div class="wrap grid">
    <div class="screen panel">
      {hasClip ? (
        <video
          class="clip"
          src={base + clip}
          poster={base + poster}
          muted
          playsinline
          loop
          preload="metadata"
          aria-label={t(record.title, lang)}
        ></video>
      ) : (
        <Image class="clip still" src={record.broadcast.src} alt={t(record.broadcast.alt, lang)} widths={[844]} />
      )}
      <div class="hud" aria-hidden="true">
        <span class="hud-tag">{t(record.resultLabel, lang)}</span>
        <span class="hud-timer num">{record.value}</span>
        <span class="hud-unit num">s</span>
      </div>
      <span class="corner tl"></span><span class="corner br"></span>
    </div>

    {hasClip && <div class="playback">
      <span data-view data-pov={t(record.povLabel, lang)} data-broadcast={t(record.broadcastLabel, lang)}>{t(record.povLabel, lang)}</span>
      <div class="controls">
        <span class="replay-time num" aria-label={t(record.replayTimeLabel, lang)}><span data-elapsed>0.0</span> / <span data-duration>21.5</span> s</span>
        <button type="button" data-toggle data-play={t(record.playLabel, lang)} data-pause={t(record.pauseLabel, lang)}>{t(record.playLabel, lang)}</button>
        <button type="button" data-replay>{t(record.replayLabel, lang)}</button>
      </div>
    </div>}

    <div class="text">
      <p class="big num" aria-hidden="true">{record.value}<span>s</span></p>
      <h2 id="record-title" class="display title">{t(record.title, lang)}</h2>
      <p class="lede">{t(record.lede, lang)}</p>
      <dl class="crew">
        {record.crew.map((c) => (
          <div><dt>{t(c.label, lang)}</dt><dd>{t(c.value, lang)}</dd></div>
        ))}
        <div><dt>{t(record.matchLabel, lang)}</dt><dd>{t(record.match, lang)}</dd></div>
      </dl>
      <a class="src" href={record.source} rel="noopener">{t(ui.watchSource, lang)}</a>
      <a class="src" href={record.povSource} rel="noopener">{t(record.povSourceLabel, lang)}</a>
    </div>
  </div>
</section>

<script>
  import { reducedMotion } from '../scripts/smooth';

  document.querySelectorAll<HTMLElement>('[data-record]').forEach((root) => {
    const video = root.querySelector<HTMLVideoElement>('video');
    const toggle = root.querySelector<HTMLButtonElement>('[data-toggle]');
    const view = root.querySelector<HTMLElement>('[data-view]');
    const elapsed = root.querySelector<HTMLElement>('[data-elapsed]');
    const duration = root.querySelector<HTMLElement>('[data-duration]');
    if (!video || !toggle || !view) return;
    let manuallyPaused = false;
    const sync = () => {
      if (elapsed) elapsed.textContent = video.currentTime.toFixed(1);
      if (duration && Number.isFinite(video.duration)) duration.textContent = video.duration.toFixed(1);
      toggle.textContent = video.paused ? toggle.dataset.play! : toggle.dataset.pause!;
      view.textContent = video.currentTime >= 17.2 ? view.dataset.broadcast! : view.dataset.pov!;
    };
    ['loadedmetadata', 'play', 'pause', 'timeupdate', 'seeked', 'ended'].forEach(event => video.addEventListener(event, sync));
    toggle.addEventListener('click', () => {
      manuallyPaused = !video.paused;
      if (video.paused) video.play().catch(() => {});
      else video.pause();
    });
    root.querySelector('[data-replay]')?.addEventListener('click', () => {
      manuallyPaused = false;
      video.currentTime = 0;
      video.play().catch(() => {});
    });
    if (reducedMotion) video.removeAttribute('loop');
    new IntersectionObserver(([e]) => {
      if (!e.isIntersecting) video.pause();
      else if (!reducedMotion && !manuallyPaused) video.play().catch(() => {});
    }, { threshold: 0.35 }).observe(video);
  });
</script>

<style>
  .record { padding: 7rem 0; }
  .record.compact { padding: 3rem 0; }
  .grid {
    display: grid;
    grid-template-columns: minmax(0, 1.35fr) minmax(0, 1fr);
    gap: clamp(2rem, 5vw, 4.5rem);
    align-items: center;
  }
  .screen {
    grid-column: 1;
    grid-row: 1;
    position: relative;
    aspect-ratio: 16 / 9;
    background: #000;
  }
  .clip {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .clip.still { object-fit: contain; background: #0a0f18; }
  .hud {
    position: absolute;
    right: 0.75rem;
    top: 0.75rem;
    display: grid;
    grid-template-columns: auto auto;
    align-items: baseline;
    column-gap: 0.35rem;
    padding: 0.6rem 0.9rem 0.5rem;
    background: rgba(7, 13, 23, 0.78);
    border-left: 3px solid var(--amber);
  }
  .hud-tag {
    grid-column: 1 / -1;
    font-size: var(--t-xs);
    letter-spacing: 0.1em;
    color: var(--ink-2);
  }
  .hud-timer {
    font-size: var(--t-2xl);
    line-height: 1.1;
    color: var(--amber);
    min-width: 3.2ch;
  }
  .playback { grid-column: 1; grid-row: 2; display: flex; justify-content: space-between; align-items: center; gap: 1rem; color: var(--ink-2); font-size: var(--t-sm); }
  .grid { row-gap: 0.75rem; }
  .controls { display: flex; align-items: center; gap: 0.5rem; }
  .replay-time { font-size: var(--t-xs); white-space: nowrap; }
  .controls button { background: transparent; border: 1px solid var(--rule); padding: 0.4rem 0.7rem; color: var(--ink); font: inherit; cursor: pointer; }
  .controls button:hover { border-color: var(--amber); }
  .controls button:focus-visible { outline: 2px solid var(--amber); outline-offset: 3px; }
  .hud-unit { color: var(--ink-2); }
  .corner {
    position: absolute;
    width: 22px;
    height: 22px;
    border: 2px solid var(--amber);
    pointer-events: none;
  }
  .corner.tl { top: 10px; left: 10px; border-right: 0; border-bottom: 0; }
  .corner.br { bottom: 10px; right: 10px; border-left: 0; border-top: 0; }

  .text { grid-column: 2; grid-row: 1 / 3; display: grid; gap: 1rem; }
  .big {
    font-size: clamp(5rem, 11vw, 9rem);
    line-height: 0.9;
    color: var(--amber);
    letter-spacing: -0.03em;
  }
  .big span { font-size: 0.35em; color: var(--ink-2); margin-left: 0.15em; }
  .title { font-size: var(--t-2xl); }
  .lede { color: var(--ink-2); }
  .crew {
    display: grid;
    gap: 0.5rem;
    margin: 0.5rem 0 0;
    padding-top: 1rem;
    border-top: 1px solid var(--rule);
  }
  .crew div { display: grid; grid-template-columns: 7rem 1fr; gap: 1rem; }
  .crew dt { color: var(--ink-3); font-size: var(--t-sm); }
  .crew dd { margin: 0; font-size: var(--t-sm); }
  .src {
    justify-self: start;
    font-size: var(--t-sm);
    color: var(--amber);
    text-underline-offset: 4px;
  }

  @media (max-width: 900px) {
    .grid { grid-template-columns: 1fr; }
    .text { grid-column: 1; grid-row: 3; margin-top: 1.5rem; }
    .hud { display: none; }
    .playback { flex-wrap: wrap; }
  }
</style>
