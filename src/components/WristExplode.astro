---
// Pinned wrist exploded view: scroll pulls the J4–J8 end of the arm apart, part by part,
// with callouts that track each group. Without WebGL/the model: a still render instead.
import { existsSync } from 'node:fs';
import { join } from 'node:path';
import { Image } from 'astro:assets';
import type { Lang } from '../data/i18n';
import fallback from '../assets/img/arm-l4.webp';

interface Props { lang: Lang }
const { lang } = Astro.props;
const hasModel = existsSync(join(process.cwd(), 'public', 'models', 'wrist.glb'));
const L = lang === 'zh'
  ? { title: '腕部拆解', hint: '向下滚动，腕部按装配顺序拆开', alt: 'L4 段与腕部结构 CAD 渲染' }
  : { title: 'Wrist exploded view', hint: 'Scroll to take the wrist apart in assembly order', alt: 'CAD render of the L4 segment and wrist' };
---
<div class="explode" data-explode data-model={hasModel ? '1' : ''} data-lang={lang}>
  <div class="pin">
    <div class="view panel">
      <div class="still"><Image src={fallback} alt={L.alt} widths={[744]} /></div>
      <canvas class="three" aria-hidden="true"></canvas>
      <svg class="leaders" aria-hidden="true"></svg>
      <ol class="labels" aria-label={L.title}></ol>
      <span class="hint">{L.hint}</span>
    </div>
  </div>
</div>

<script>
  import { gsap, ScrollTrigger, reducedMotion } from '../scripts/smooth';

  document.querySelectorAll<HTMLElement>('[data-explode][data-model="1"]').forEach((root) => {
    const canvas = root.querySelector<HTMLCanvasElement>('canvas')!;
    const svg = root.querySelector<SVGSVGElement>('svg.leaders')!;
    const list = root.querySelector<HTMLOListElement>('ol.labels')!;
    const zh = root.dataset.lang === 'zh';
    const NS = 'http://www.w3.org/2000/svg';

    const start = () => import('../scripts/wrist-scene').then(async ({ loadWristScene }) => {
      const scene = await loadWristScene(canvas, import.meta.env.BASE_URL);
      // label column order: by where each part ends up on screen, so leaders don't cross
      scene.setExplode(1);
      scene.setYaw(22);
      const endY = new Map(scene.render().map((c) => [c.key, c.y]));
      const groups = [...scene.groups].sort((a, b) => endY.get(a.key)! - endY.get(b.key)!);
      const items = groups.map((g, i) => {
        const li = document.createElement('li');
        li.innerHTML = `<span class="n">${String(i + 1).padStart(2, '0')}</span><span class="t"></span>`;
        li.querySelector('.t')!.textContent = zh ? g.label_zh : g.label_en;
        list.appendChild(li);
        const line = document.createElementNS(NS, 'path');
        const dot = document.createElementNS(NS, 'circle');
        dot.setAttribute('r', '3');
        svg.append(line, dot);
        return { g, li, line, dot };
      });

      let t = reducedMotion ? 1 : 0;
      const draw = () => {
        scene.setExplode(t);
        scene.setYaw(gsap.utils.interpolate(-18, 22, t));
        const pts = new Map(scene.render().map((c) => [c.key, c]));
        const box = root.querySelector('.view')!.getBoundingClientRect();
        const reveal = gsap.utils.clamp(0, 1, (t - 0.55) / 0.3);
        for (const it of items) {
          const c = pts.get(it.g.key)!;
          const r = it.li.getBoundingClientRect();
          const lx = r.left - box.left - 6, ly = r.top - box.top + r.height / 2;
          const elbow = lx - 28;
          it.line.setAttribute('d', `M${c.x.toFixed(1)},${c.y.toFixed(1)} L${elbow},${ly} L${lx},${ly}`);
          it.dot.setAttribute('cx', c.x.toFixed(1));
          it.dot.setAttribute('cy', c.y.toFixed(1));
          it.line.style.opacity = it.dot.style.opacity = String(reveal * (c.visible ? 1 : 0));
          it.li.style.opacity = String(0.25 + 0.75 * reveal);
        }
      };
      scene.onResize(draw);
      root.classList.add('has-3d');
      draw();
      if (reducedMotion) return;
      ScrollTrigger.create({
        trigger: root,
        start: 'top top+=76',
        end: '+=160%',
        pin: root.querySelector('.pin'),
        scrub: 0.6,
        onUpdate: (st) => { t = Math.min(1, st.progress / 0.85); draw(); },
      });
      ScrollTrigger.refresh();
    }).catch((err) => console.warn('wrist scene unavailable, keeping the still', err));

    const io = new IntersectionObserver(([en]) => {
      if (en.isIntersecting) { io.disconnect(); start(); }
    }, { rootMargin: '900px 0px' });
    io.observe(root);
  });
</script>

<style>
  .explode { margin-top: 0.5rem; }
  .view {
    position: relative;
    height: min(70vh, 62vw);
    min-height: 360px;
    background: var(--ground);
  }
  .still {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    background: var(--plate);
    transition: opacity 0.5s;
  }
  .still :global(img) { max-height: 90%; width: auto; mix-blend-mode: multiply; }
  .three, .leaders, .labels, .hint { opacity: 0; transition: opacity 0.6s; }
  .has-3d .still { opacity: 0; }
  .has-3d .three, .has-3d .leaders, .has-3d .labels, .has-3d .hint { opacity: 1; }
  .three, .leaders { position: absolute; inset: 0; width: 100%; height: 100%; }
  .leaders { pointer-events: none; overflow: visible; }
  .leaders :global(path) { fill: none; stroke: var(--amber); stroke-width: 1; }
  .leaders :global(circle) { fill: var(--amber); }

  .labels {
    position: absolute;
    right: 1.4rem;
    top: 50%;
    transform: translateY(-50%);
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.35rem;
    width: min(16rem, 30%);
  }
  .labels :global(li) {
    display: grid;
    grid-template-columns: 2rem 1fr;
    align-items: baseline;
    font-size: var(--t-xs);
    color: var(--ink-2);
    padding: 0.15rem 0 0.15rem 0.5rem;
    border-left: 1px solid var(--rule);
    background: rgba(7, 13, 23, 0.6);
  }
  .labels :global(.n) { font-family: var(--f-mono); color: var(--amber); }
  .hint {
    position: absolute;
    left: 1.2rem;
    bottom: 1rem;
    font-size: var(--t-xs);
    color: var(--ink-3);
  }
  @media (max-width: 760px) {
    .labels { display: none; }
    .leaders { display: none; }
  }
</style>
