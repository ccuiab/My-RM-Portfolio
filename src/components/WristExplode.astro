---
import { existsSync } from 'node:fs';
import { join } from 'node:path';
import { Image } from 'astro:assets';
import { t, type Lang } from '../data/i18n';
import { sceneCopy } from '../data/content';
import fallback from '../../materials/images/derived/site/cad-cutouts/l4-assembled.png';

interface Props { lang: Lang }
const { lang } = Astro.props;
const hasModel = existsSync(join(process.cwd(), 'materials', 'models', 'derived', 'web', 'l4.glb'));
const L = sceneCopy.wristExplode;
---
<section class="explode" data-explode data-model={hasModel ? '1' : ''} data-lang={lang} data-state="assembled">
  <header class="intro"><h3>{t(L.title, lang)}</h3></header>
  <div class="view">
    <div class="still cutout"><Image src={fallback} alt={t(L.alt, lang)} widths={[900, 1600, 2400]} sizes="100vw" /></div>
    <canvas class="three" tabindex="-1" role="img" aria-label={t(L.hint, lang)}></canvas>
  </div>
  {hasModel && (
    <div class="controls">
      <div class="states" role="group" aria-label={t(sceneCopy.interaction.wrist, lang)}>
        <button type="button" data-explode-to="0" aria-pressed="true">{t(L.assemble, lang)}</button>
        <button type="button" data-explode-to="1" aria-pressed="false">{t(L.explode, lang)}</button>
      </div>
      <button type="button" data-reset-view disabled>{t(sceneCopy.interaction.reset, lang)}</button>
      <span class="hint">{t(L.hint, lang)}</span>
    </div>
  )}
  <p class="status" role="status" data-status data-loading={t(sceneCopy.module.loading, lang)} data-failed={t(sceneCopy.module.failed, lang)} hidden></p>
  <details class="parts" hidden>
    <summary>{t(L.parts, lang)}</summary>
    <ol class="labels" aria-label={t(L.parts, lang)}></ol>
  </details>
</section>

<script>
  import type { WristScene } from '../scripts/wrist-scene';

  document.querySelectorAll<HTMLElement>('[data-explode][data-model="1"]').forEach((root) => {
    const canvas = root.querySelector<HTMLCanvasElement>('canvas')!;
    const status = root.querySelector<HTMLElement>('[data-status]')!;
    const list = root.querySelector<HTMLOListElement>('.labels')!;
    const parts = root.querySelector<HTMLDetailsElement>('.parts')!;
    const reset = root.querySelector<HTMLButtonElement>('[data-reset-view]')!;
    const buttons = [...root.querySelectorAll<HTMLButtonElement>('[data-explode-to]')];
    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
    let scene: WristScene | undefined;
    let loading: Promise<void> | undefined;
    let progress = 0;
    let target = 0;
    let frame = 0;

    const syncButtons = () => {
      buttons.forEach((button) => button.setAttribute('aria-pressed', String(Number(button.dataset.explodeTo) === target)));
      root.dataset.state = target === 1 ? 'exploded' : 'assembled';
    };
    const draw = () => {
      scene?.setExplode(progress);
      scene?.render();
      root.dataset.progress = progress.toFixed(3);
    };
    const transition = () => {
      cancelAnimationFrame(frame);
      if (!scene) return;
      const from = progress;
      const to = target;
      const startTime = performance.now();
      const duration = reducedMotion.matches ? 0 : 650 * Math.abs(to - from);
      const tick = (now: number) => {
        const elapsed = duration ? Math.min(1, (now - startTime) / duration) : 1;
        progress = from + (to - from) * elapsed;
        draw();
        if (elapsed < 1) frame = requestAnimationFrame(tick);
      };
      frame = requestAnimationFrame(tick);
    };
    const start = (): Promise<void> => {
      if (scene) return Promise.resolve();
      if (loading) return loading;
      status.hidden = false;
      status.textContent = status.dataset.loading!;
      loading = import('../scripts/wrist-scene').then(async ({ loadWristScene }) => {
        scene = await loadWristScene(canvas, import.meta.env.BASE_URL);
        scene.setYaw(22);
        scene.onResize(draw);
        scene.onInteraction(draw);
        const labels = scene.groups.map((group, index) => {
          const item = document.createElement('li');
          const number = document.createElement('span');
          number.className = 'num';
          number.textContent = String(index + 1).padStart(2, '0');
          const label = document.createElement('span');
          label.textContent = root.dataset.lang === 'zh' ? group.label_zh : group.label_en;
          item.append(number, label);
          return item;
        });
        list.replaceChildren(...labels);
        root.classList.add('has-3d');
        reset.disabled = false;
        parts.hidden = false;
        status.hidden = true;
        draw();
        transition();
      }).catch((error) => {
        loading = undefined;
        target = 0;
        syncButtons();
        status.textContent = status.dataset.failed!;
        console.warn('wrist scene unavailable, keeping the still', error);
      });
      return loading;
    };

    buttons.forEach((button) => button.addEventListener('click', () => {
      target = Number(button.dataset.explodeTo);
      syncButtons();
      if (scene) transition();
      else void start();
    }));
    reset.addEventListener('click', () => scene?.resetView());
    const observer = new IntersectionObserver(([entry]) => {
      if (entry.isIntersecting) { observer.disconnect(); void start(); }
    }, { rootMargin: '500px 0px' });
    observer.observe(root);
  });
</script>

<style>
  .explode { display: grid; gap: 1.2rem; min-width: 0; }
  .intro { display: grid; grid-template-columns: minmax(0, .85fr) minmax(0, 1.15fr); gap: clamp(1.5rem, 4vw, 3.5rem); }
  .intro h3 { margin: 0 0 .5rem; font-family: var(--f-cjk); font-size: var(--t-lg); }
  :global(html[lang="en"]) .intro h3 { font-family: var(--f-latin); font-weight: 600; }
  .intro p { color: var(--ink-2); font-size: var(--t-sm); line-height: 1.8; }
  .view { position: relative; height: clamp(380px, 38vw, 520px); background: radial-gradient(ellipse at 50% 45%, #182438, var(--ground) 78%); }
  .still, .three { position: absolute; inset: 0; width: 100%; height: 100%; }
  .still :global(img) { width: 100%; height: 100%; object-fit: contain; padding: 3%; }
  .three { opacity: 0; pointer-events: none; cursor: grab; touch-action: none; }
  .has-3d .still { visibility: hidden; }
  .has-3d .three { opacity: 1; pointer-events: auto; }
  .three:active { cursor: grabbing; }
  .controls { display: flex; flex-wrap: wrap; align-items: center; gap: .75rem 1rem; }
  .states { display: flex; gap: .5rem; }
  button { border: 1px solid var(--rule); padding: .55rem .8rem; color: var(--ink-2); background: var(--ground); font: inherit; font-size: var(--t-sm); cursor: pointer; }
  button[aria-pressed="true"], button:hover { color: var(--amber); border-color: var(--amber); }
  button:disabled { opacity: .5; cursor: default; }
  .hint { flex-basis: 100%; color: var(--ink-3); font-size: var(--t-xs); }
  .status { color: var(--ink-2); font-size: var(--t-sm); }
  .parts { padding-top: .75rem; border-top: 1px solid var(--rule); }
  .parts summary { color: var(--ink-2); font-size: var(--t-sm); cursor: pointer; }
  .labels { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: .8rem 1rem; list-style: none; margin: 1rem 0 0; padding: 0; }
  .labels :global(li) { display: grid; grid-template-columns: 1.5rem minmax(0, 1fr); gap: .5rem; color: var(--ink-2); font-size: var(--t-xs); }
  .labels :global(.num) { color: var(--amber); }
  [hidden] { display: none; }
  @media (max-width: 900px) { .intro { grid-template-columns: minmax(0, 1fr); gap: .5rem; } .labels { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (max-width: 540px) { .view { height: 360px; } button { padding: .5rem .6rem; font-size: var(--t-xs); } }
</style>
