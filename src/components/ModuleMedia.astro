---
import { Image } from 'astro:assets';
import { existsSync } from 'node:fs';
import { join } from 'node:path';
import { sceneCopy, type Pic } from '../data/content';
import { t, ui, type Lang } from '../data/i18n';
import MechanismMedia from './MechanismMedia.astro';
interface Props { pic: Pic; lang: Lang; concise?: boolean }
const { pic, lang, concise = false } = Astro.props;
const L = sceneCopy.module;
const mechanism = pic.model === 'engineer-pump.glb' ? 'pump' : pic.model === 'engineer-swerve.glb' ? 'swerve' : undefined;
if (!pic.model || !existsSync(join(process.cwd(), 'materials/models/derived/web', pic.model))) throw new Error(`Missing module model: ${pic.model}`);
---
{mechanism ? <MechanismMedia pic={pic} lang={lang} kind={mechanism} concise={concise} /> : <figure class="module-media" data-module-media data-cutout={pic.cutout ? "true" : undefined} data-model={pic.model} data-failed={t(L.failed, lang)} data-loading={t(L.loading, lang)}>
  <div class="media-view">
    <button class:list={['photo', { light: pic.light, cutout: pic.cutout }]} type="button" data-module-photo data-zoom={pic.src.src} data-alt={t(pic.alt, lang)} aria-label={`${t(ui.enlarge, lang)}: ${t(pic.alt, lang)}`}>
      <Image src={pic.src} alt={t(pic.alt, lang)} widths={[480, 900, 1400, 2400]} sizes="(max-width: 900px) 100vw, 80vw" />
    </button>
    <div class="model" data-module-view></div>
    <p class="status" data-module-status role="status">{t(L.loading, lang)}</p>
  </div>
  <div class="controls" data-module-controls hidden>
    <span>{t(L.hint, lang)}</span>
    <div class="actions"><button type="button" data-module-spin data-resume={t(L.rotate, lang)} data-pause={t(L.pause, lang)} aria-pressed="true">{t(L.pause, lang)}</button>
    <button type="button" data-module-reset>{t(sceneCopy.interaction.reset, lang)}</button>
    <button type="button" data-zoom={pic.src.src} data-alt={t(pic.alt, lang)}>{t(L.photo, lang)}</button></div>
  </div>
  <figcaption>{t(pic.alt, lang)}{pic.modelNote && <small>{t(pic.modelNote, lang)}</small>}</figcaption>
</figure>}
<script>
  import '../scripts/module-media';
</script>
<style>
  .module-media { margin: 0; min-width: 0; background: var(--panel); }
  button { color: var(--ink-2); background: transparent; font: inherit; font-size: var(--t-xs); cursor: pointer; }
  button:focus-visible { outline: 2px solid var(--amber); outline-offset: 2px; }
  .media-view { position: relative; height: clamp(300px, 40vw, 530px); overflow: hidden; background: radial-gradient(ellipse at 50% 45%, #182438, var(--ground) 78%); }
  .photo { visibility: visible; position: absolute; inset: 0; width: 100%; height: 100%; padding: 2%; border: 0; cursor: zoom-in; background: var(--plate); }
  .photo :global(img) { width: 100%; height: 100%; object-fit: contain; }
  .photo.light :global(img) { mix-blend-mode: multiply; }
  .model { position: absolute; inset: 0; pointer-events: none; }
  [data-ready="true"] .model { pointer-events: auto; }
  [data-failed-state="true"] .photo { visibility: visible; }
  .model :global(canvas) { width: 100%; height: 100%; touch-action: none; }
  [data-ready="true"] .photo { visibility: hidden; }
  .status { position: absolute; left: 1rem; bottom: 1rem; margin: 0; padding: .55rem .9rem; border: 1px solid var(--rule); color: var(--ink-2); background: rgba(7, 13, 23, .88); font: var(--t-xs) var(--f-mono); letter-spacing: .04em; white-space: nowrap; pointer-events: none; }
  .status[hidden] { display: none; }
  .controls { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: .5rem; padding: .7rem 1rem; color: var(--ink-3); font-size: var(--t-xs); }
  .actions { display: flex; flex-wrap: wrap; border: 1px solid var(--rule); }
  .controls button { display: inline-flex; align-items: center; justify-content: center; min-height: 34px; border: 0; border-right: 1px solid var(--rule); padding: .45rem .8rem; background: transparent; line-height: 1.2; transition: color .15s, background-color .15s; }
  .controls button:last-child { border-right: 0; }
  .controls button:hover { color: var(--ink); background: var(--panel-2); }
  .controls button[aria-pressed="true"] { color: var(--amber); background: var(--amber-dim); }
  figcaption { padding: .8rem 1rem; font-size: var(--t-sm); color: var(--ink); border-top: 1px solid var(--rule); }
  small { display: block; margin-top: .25rem; color: var(--ink-3); font-size: var(--t-xs); }
  [hidden] { display: none !important; }
  @media (min-width: 901px) and (pointer: fine) and (prefers-reduced-motion: no-preference) {
    .controls[hidden] { display: flex !important; visibility: hidden; pointer-events: none; }
  }
  @media (max-width: 900px), (prefers-reduced-motion: reduce) {
    .model, .controls { display: none !important; }
    .photo { visibility: visible !important; }
  }
  @media(max-width: 640px) { .media-view { height: 320px; } }
</style>
