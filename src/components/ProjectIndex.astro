---
// Home: the three project sheets, laid out as drawing-sheet title blocks.
import { Image } from 'astro:assets';
import { engineer, hero, research, pageCopy } from '../data/content';
import { t, href, ui, type Lang } from '../data/i18n';

interface Props { lang: Lang }
const { lang } = Astro.props;

const sheets = [engineer, hero, research].map((p, i) => ({
  p, no: 'robotNo' in p ? p.robotNo : null,
  figure: pageCopy.projectFigures[i].value, figureLabel: pageCopy.projectFigures[i].label,
}));
---
<section id="projects" class="index wrap" aria-labelledby="index-title">
  <h2 id="index-title" class="display heading">{t(pageCopy.projectTitle, lang)}</h2>

  <ol class="sheets">
    {sheets.map(({ p, no, figure, figureLabel }, i) => (
      <li class="sheet">
        <a class="sheet-link panel" href={href(lang, p.slug)}>
          <div class:list={['pic', { light: p.cover.light }]}>
            <Image src={p.cover.src} alt={t(p.cover.alt, lang)} widths={[640, 1100]} sizes="(max-width: 760px) 100vw, (max-width: 1100px) 50vw, 33vw" />
            {no && <span class="robot-no num" aria-hidden="true">{no}</span>}
          </div>
          <div class="block">
            <span class="dwg num">{p.drawing}</span>
            <h3 class="display name">{t(p.title, lang)}</h3>
            <p class="lede">{t(p.lede, lang)}</p>
            <div class="figure">
              <span class="num fig">{figure}</span>
              <span class="fig-label">{t(figureLabel, lang)}</span>
            </div>
            <span class="go">{t(ui.openProject, lang)}</span>
          </div>
        </a>
      </li>
    ))}
  </ol>
</section>

<style>
  .index { padding-top: 2.5rem; scroll-margin-top: 5rem; }
  .heading { font-size: var(--t-3xl); margin-bottom: 1.7rem; }
  .sheets {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1.5rem;
  }
  .sheet-link {
    display: grid;
    grid-template-rows: auto 1fr;
    height: 100%;
    color: inherit;
    text-decoration: none;
    transition: transform 0.25s ease;
  }
  .sheet-link:hover { transform: translateY(-3px); }
  .sheet-link:hover .go { color: var(--amber); }

  .pic {
    position: relative;
    aspect-ratio: 16 / 10;
    overflow: hidden;
    background: #04070c;
  }
  .pic :global(img) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .pic.light {
    background:
      linear-gradient(var(--plate-line) 1px, transparent 1px) 0 0 / 100% 32px,
      linear-gradient(90deg, var(--plate-line) 1px, transparent 1px) 0 0 / 32px 100%,
      var(--plate);
  }
  .pic.light :global(img) { object-fit: contain; padding: 4% 6%; mix-blend-mode: multiply; }
  .robot-no {
    position: absolute;
    right: 1rem;
    bottom: 0.4rem;
    font-family: var(--f-latin);
    font-weight: 700;
    font-size: 6rem;
    line-height: 1;
    color: transparent;
    -webkit-text-stroke: 1.5px rgba(242, 181, 58, 0.8);
  }
  .pic.light .robot-no { -webkit-text-stroke-color: rgba(7, 13, 23, 0.55); }

  .block {
    display: grid;
    grid-template-rows: auto auto 1fr auto auto;
    gap: 0.9rem;
    padding: 1.4rem;
    border-top: 1px solid var(--rule);
  }
  .dwg {
    font-size: var(--t-xs);
    color: var(--ink-3);
    letter-spacing: 0.08em;
  }
  .name { font-size: var(--t-xl); }
  .lede { color: var(--ink-2); font-size: var(--t-sm); }
  .figure {
    display: grid;
    align-content: start;
    gap: 0.45rem;
    padding-top: 0.9rem;
    border-top: 1px solid var(--rule);
  }
  .fig { font-size: var(--t-xl); color: var(--amber); white-space: nowrap; flex-shrink: 0; }
  .fig-label { font-size: var(--t-sm); color: var(--ink-2); min-height: 3em; }
  .go {
    font-size: var(--t-sm);
    color: var(--ink-2);
    text-decoration: underline;
    text-underline-offset: 4px;
    transition: color 0.2s;
  }

  @media (min-width: 761px) and (max-width: 1100px) {
    .sheets { grid-template-columns: repeat(2, minmax(0,1fr)); }
    .sheet:last-child { grid-column: 1 / -1; }
    .sheet:last-child .sheet-link { grid-template-columns: 1fr 1fr; grid-template-rows: auto; }
    .sheet:last-child .block { border-top: 0; border-left: 1px solid var(--rule); }
    .sheet:last-child .pic { aspect-ratio: auto; }
  }
  @media (max-width: 760px) {
    .index { padding-top: 1.5rem; }
    .sheets { grid-template-columns: 1fr; }
    .heading { font-size: var(--t-2xl); }
  }
</style>
