---
// Home: the three project sheets, laid out as drawing-sheet title blocks.
import { Image } from 'astro:assets';
import { engineer, hero, research, pageCopy } from '../data/content';
import { t, href, ui, type Lang } from '../data/i18n';

interface Props { lang: Lang }
const { lang } = Astro.props;

const sheets = [engineer, hero, research].map((p, i) => ({
  p, no: 'robotNo' in p ? p.robotNo : null,
  figure: pageCopy.projectFigures[i].value, figureLabel: pageCopy.projectFigures[i].label,
}));
---
<section id="projects" class="index wrap" aria-labelledby="index-title">
  <h2 id="index-title" class="display heading">{t(pageCopy.projectTitle, lang)}</h2>

  <ol class="sheets">
    {sheets.map(({ p, no, figure, figureLabel }, i) => (
      <li class="sheet">
        <a class="sheet-link" href={href(lang, p.slug)}>
          <div class:list={['pic', { light: p.cover.light }]}>
            <Image src={p.cover.src} alt={t(p.cover.alt, lang)} widths={[640, 1100, 1800]} sizes="(max-width: 900px) 100vw, 60vw" />
            {no && <span class="robot-no num" aria-hidden="true">{no}</span>}
          </div>
          <div class="block">
            <span class="dwg num">{p.drawing}</span>
            <h3 class="display name">{t(p.short, lang)}</h3>
            <p class="lede">{t(p.lede, lang)}</p>
            <div class="figure">
              <span class="num fig">{figure}</span>
              <span class="fig-label">{t(figureLabel, lang)}</span>
            </div>
            <span class="go">{t(ui.openProject, lang)}</span>
          </div>
        </a>
      </li>
    ))}
  </ol>
</section>

<style>
  .index { padding-top: clamp(4rem, 8vw, 8rem); scroll-margin-top: 6rem; }
  .heading { font-size: clamp(2.6rem, 5vw, 4.8rem); margin-bottom: 3rem; }
  .sheets { list-style: none; margin: 0; padding: 0; display: grid; gap: clamp(4rem, 8vw, 7rem); }
  .sheet-link { display: grid; grid-template-columns: minmax(0, 1.35fr) minmax(0, 1fr); gap: clamp(2rem, 5vw, 5rem); align-items: center; color: inherit; text-decoration: none; }
  .sheet:nth-child(2) .pic { order: 2; }
  .sheet:nth-child(2) .sheet-link { grid-template-columns: minmax(0, 1fr) minmax(0, 1.35fr); }
  .pic { position: relative; aspect-ratio: 6 / 5; overflow: hidden; background: var(--panel); }
  .pic :global(img) { width: 100%; height: 100%; object-fit: contain; transition: transform .6s ease; }
  .pic.light { background: var(--plate); }
  .pic.light :global(img) { padding: 2%; mix-blend-mode: multiply; }
  .sheet-link:hover .pic :global(img) { transform: scale(1.035); }
  .robot-no { position: absolute; right: 1.3rem; bottom: .7rem; font-family: var(--f-latin); font-size: clamp(5rem, 9vw, 9rem); line-height: 1; color: transparent; -webkit-text-stroke: 1px rgba(242,181,58,.75); }
  .pic.light .robot-no { -webkit-text-stroke-color: rgba(7,13,23,.35); }
  .block { display: grid; gap: 1.5rem; padding: 1rem 0; }
  .dwg { font-size: var(--t-xs); color: var(--amber); }
  .name { font-size: clamp(2.2rem, 3.8vw, 4rem); line-height: 1.12; max-width: 15ch; }
  .lede { color: var(--ink-2); font-size: var(--t-sm); max-width: 43ch; line-height: 1.85; }
  .figure { display: flex; align-items: center; gap: 1.4rem; padding-top: 1.5rem; border-top: 1px solid var(--rule); }
  .fig { font-size: clamp(1.8rem, 2.5vw, 2.8rem); color: var(--ink); white-space: nowrap; }
  .fig-label { font-size: var(--t-xs); color: var(--ink-3); max-width: 19ch; }
  .go { display: inline-flex; justify-self: start; align-items: center; gap: 2rem; font-size: var(--t-sm); color: var(--amber); padding: .6rem 0; }
  .go::after { content: ''; width: 2.5rem; height: .5rem; border-top: 1px solid currentColor; border-right: 1px solid currentColor; transform: skewX(40deg) translateY(.2rem); transition: width .25s; }
  .sheet-link:hover .go::after { width: 4rem; }
  @media (max-width: 900px) {
    .sheet-link, .sheet:nth-child(2) .sheet-link { grid-template-columns: 1fr; gap: 1.8rem; }
    .sheet:nth-child(2) .pic { order: 0; }
    .pic { aspect-ratio: 4 / 3; }
    .block { gap: 1.1rem; padding: 0; }
    .name { max-width: none; font-size: clamp(2.2rem, 7vw, 3.5rem); }
    .lede { max-width: 60ch; }
    .figure { padding-top: 1.2rem; }
    .heading { margin-bottom: 2rem; }
  }
</style>
