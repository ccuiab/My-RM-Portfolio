---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import ProjectHeader from './ProjectHeader.astro';
import Lightbox from './Lightbox.astro';
import NextSheet from './NextSheet.astro';
import ModuleMedia from './ModuleMedia.astro';
import { research, engineer, type Stage } from '../data/content';
import { t, ui, type Lang, type T } from '../data/i18n';
import lines from '../assets/gen/launcher-dual-6-lines.webp';

interface Props { lang: Lang }
const { lang } = Astro.props;
const r = research;

const lines_: { id: string; mark: string; title: T; stages: Stage[]; lede?: T; after?: T; branch?: boolean }[] = [
  { id: 'launcher', mark: 'A', title: r.launcher.title, stages: r.launcher.stages },
  { id: 'feeder', mark: 'B', title: r.feeder.title, stages: r.feeder.stages, after: r.feeder.mentor },
  { id: 'swerve', mark: 'C', title: r.swerve.title, stages: r.swerve.branches, lede: r.swerve.lede, branch: true },
];
---
<Base lang={lang} slug={r.slug} title={r.short} description={r.lede}>
  <ProjectHeader lang={lang} drawing={r.drawing} title={r.title} lede={r.lede} cover={r.cover} lines={lines} />

  {lines_.map((line) => (
    <section class="line" id={line.id} aria-labelledby={`${line.id}-title`}>
      <div class="wrap">
        <div class="line-head">
          <span class="mark" aria-hidden="true">{line.mark}</span>
          <h2 id={`${line.id}-title`} class="display line-title">{t(line.title, lang)}</h2>
        </div>
        {line.lede && <p class="line-lede">{t(line.lede, lang)}</p>}

        <ol class:list={['stages', { branch: line.branch }]}>
          {line.stages.map((s, i) => (
            <li class="stage">
              <div class="stage-rail" aria-hidden="true">
                <span class="num idx">{line.branch ? String.fromCharCode(97 + i) : `v${i + 1}`}</span>
              </div>
              <div class="stage-visual">
              {s.pic?.model ? <ModuleMedia pic={s.pic} lang={lang} /> : s.pic ? (
                <button class:list={['pic', { light: s.pic.light }]} type="button" data-zoom={s.pic.src.src} data-alt={t(s.pic.alt, lang)} aria-label={`${t(ui.enlarge, lang)}: ${t(s.pic.alt, lang)}`}>
                  <Image src={s.pic.src} alt={t(s.pic.alt, lang)} widths={[480, 900, 1400, 2400]} sizes="(max-width: 900px) 100vw, 60vw" />
                </button>
              ) : (
                <div class="pic empty" aria-hidden="true"><span class="num">&gt;25 Hz</span></div>
              )}
              </div>
              <div class="stage-copy">
              <h3 class="stage-title">{t(s.title, lang)}</h3>
              <p class="stage-body">{t(s.body, lang)}</p>
              </div>
            </li>
          ))}
        </ol>
        {line.after && <p class="after">{t(line.after, lang)}</p>}
      </div>
    </section>
  ))}

  <NextSheet lang={lang} slug={engineer.slug} drawing={engineer.drawing} title={engineer.title} />
  <Lightbox lang={lang} />
</Base>

<style>
  .line { padding-top: clamp(5rem, 9vw, 9rem); }
  .line-head { display: flex; align-items: center; gap: 1.5rem; padding-bottom: 2rem; border-bottom: 1px solid var(--rule); }
  .mark {
    display: grid;
    place-items: center;
    flex: none;
    width: 3.75rem;
    height: 3.75rem;
    border: 1.5px solid var(--amber);
    border-radius: 50%;
    font-family: var(--f-latin);
    font-weight: 700;
    font-size: var(--t-xl);
    color: var(--amber);
  }
  .line-title { font-size: clamp(1.8rem, 3.2vw, 2.8rem); line-height: 1.25; max-width: 24ch; }
  .line-lede { margin-top: 1.5rem; margin-left: 5.25rem; max-width: 44rem; color: var(--ink-2); }

  .stages {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
  }
  .stage {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1.7fr) minmax(0, 1fr);
    grid-template-areas: 'visual copy';
    align-items: center;
    gap: clamp(2rem, 5vw, 5rem);
    padding: 3rem 0 3rem 5.25rem;
    border-bottom: 1px solid var(--rule-soft);
  }
  .stage:last-child { padding-bottom: 0; border-bottom: 0; }
  .stage-visual { grid-area: visual; min-width: 0; }
  .stage-copy { grid-area: copy; padding-block: 2rem; }
  .stage-rail {
    position: absolute;
    left: 0;
    top: 3rem;
    bottom: 0;
    width: 3.75rem;
    display: flex;
    justify-content: center;
  }
  .stages:not(.branch) .stage:not(:last-child) .stage-rail::before {
    content: '';
    position: absolute;
    top: 3.2rem;
    bottom: -3rem;
    left: 50%;
    border-left: 1px solid var(--rule);
  }
  .idx { align-self: flex-start; color: var(--amber); font-size: var(--t-xl); line-height: 1; padding: .65rem 0; }
  .branch .idx { width: 2.8rem; text-align: center; border: 1px dashed var(--rule); border-radius: 50%; }
  .stage-visual :global(.module-media) { border-color: var(--rule); }
  .stage-visual :global(.media-view) { aspect-ratio: 5 / 4; }
  .stage-visual :global(.media-switch button) { padding-block: .9rem; }
  .pic {
    display: block;
    width: 100%;
    padding: 0;
    border: 1px solid var(--rule);
    background: #04070c;
    cursor: zoom-in;
  }
  .pic.light {
    background:
      linear-gradient(var(--plate-line) 1px, transparent 1px) 0 0 / 100% 32px,
      linear-gradient(90deg, var(--plate-line) 1px, transparent 1px) 0 0 / 32px 100%,
      var(--plate);
  }
  .pic :global(img) { width: 100%; aspect-ratio: 4 / 3; object-fit: contain; padding: 2%; }
  .pic.light :global(img) { mix-blend-mode: multiply; }
  .pic:hover { border-color: var(--amber); }
  .pic.empty {
    display: grid;
    place-items: center;
    aspect-ratio: 5 / 4;
    cursor: default;
    background:
      repeating-linear-gradient(-45deg, transparent 0 14px, rgba(242, 181, 58, 0.06) 14px 15px),
      var(--panel);
  }
  .pic.empty .num { font-size: clamp(3rem, 7vw, 6rem); color: var(--amber); line-height: 1; }
  .stage-title { font-family: var(--f-cjk); font-size: clamp(1.5rem, 2.2vw, 2.1rem); font-weight: 400; line-height: 1.35; }
  :global(html[lang="en"]) .stage-title { font-family: var(--f-latin); font-weight: 600; }
  .stage-body { margin-top: 1.5rem; color: var(--ink-2); font-size: var(--t-md); line-height: 1.9; max-width: 38ch; }
  .after {
    margin: 3rem 0 0 5.25rem;
    padding: 1.25rem 0 1.25rem 1.5rem;
    border-left: 2px solid var(--amber);
    color: var(--ink-2);
    font-size: var(--t-sm);
  }
  @media (max-width: 900px) {
    .line-head { gap: 1rem; padding-bottom: 1.5rem; }
    .mark { width: 2.8rem; height: 2.8rem; font-size: var(--t-lg); }
    .line-lede { margin-left: 0; }
    .stage { padding: 2.5rem 0 2.5rem 3.8rem; gap: 1.25rem; grid-template-columns: minmax(0, 1fr); grid-template-areas: 'copy' 'visual'; }
    .stage-rail { top: 2.5rem; width: 2.8rem; }
    .idx { font-size: var(--t-lg); }
    .stage-copy { padding: 0; }
    .stage-body { margin-top: .8rem; max-width: 60ch; }
    .stages:not(.branch) .stage:not(:last-child) .stage-rail::before { bottom: -2.5rem; }
    .after { margin-left: 3.8rem; }
  }
  @media (max-width: 540px) {
    .stage { padding-left: 0; padding-top: 4.5rem; }
    .stage-rail { top: 1.5rem; justify-content: flex-start; }
    .stages:not(.branch) .stage:not(:last-child) .stage-rail::before { display: none; }
    .stage-visual :global(.media-view) { aspect-ratio: 1 / 1; }
    .after { margin-left: 0; }
  }
</style>
