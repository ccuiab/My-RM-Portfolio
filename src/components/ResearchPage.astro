---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import ProjectHeader from './ProjectHeader.astro';
import Lightbox from './Lightbox.astro';
import NextSheet from './NextSheet.astro';
import { research, engineer, type Stage } from '../data/content';
import { t, ui, type Lang, type T } from '../data/i18n';

interface Props { lang: Lang }
const { lang } = Astro.props;
const r = research;

const lines_: { id: string; mark: string; title: T; stages: Stage[]; after?: T }[] = [
  { id: 'launcher', mark: 'A', title: r.launcher.title, stages: r.launcher.stages },
  { id: 'feeder', mark: 'B', title: r.feeder.title, stages: r.feeder.stages, after: r.feeder.mentor },
  { id: 'swerve', mark: 'C', title: r.swerve.title, stages: r.swerve.branches },
];
---
<Base lang={lang} slug={r.slug} title={r.short} description={r.title}>
  <ProjectHeader lang={lang} drawing={r.drawing} title={r.title} />

  {lines_.map((line) => (
    <section class="line" id={line.id} aria-labelledby={`${line.id}-title`}>
      <div class="wrap">
        <div class="line-head">
          <span class="mark" aria-hidden="true">{line.mark}</span>
          <h2 id={`${line.id}-title`} class="display line-title">{t(line.title, lang)}</h2>
        </div>
        <ol class="stages">
          {line.stages.map((s, i) => (
            <li class="stage">
              <figure class="stage-visual">
                <button class:list={['pic', { light: s.pic.light, cutout: s.pic.cutout }]} type="button" data-zoom={s.pic.src.src} data-alt={t(s.pic.alt, lang)} aria-label={`${t(ui.enlarge, lang)}: ${t(s.pic.alt, lang)}`}>
                  <Image src={s.pic.src} alt={t(s.pic.alt, lang)} widths={[480, 900, 1400, 2400]} sizes="(max-width: 900px) 100vw, (max-width: 1280px) 55vw, 640px" />
                </button>
                <figcaption>{t(s.pic.alt, lang)}</figcaption>
              </figure>
              <div class="stage-copy">
                <div class="stage-heading">
                  <span class="num idx" aria-hidden="true">{line.mark}{i + 1}</span>
                  <h3 class="stage-title">{t(s.title, lang)}</h3>
                </div>
                <p class="stage-body">{t(s.body, lang)}</p>
              </div>
            </li>
          ))}
        </ol>
        {line.after && <p class="after">{t(line.after, lang)}</p>}
      </div>
    </section>
  ))}

  <NextSheet lang={lang} slug={engineer.slug} drawing={engineer.drawing} title={engineer.title} />
  <Lightbox lang={lang} />
</Base>

<style>
  .line { padding-top: clamp(3.5rem, 6vw, 5.5rem); scroll-margin-top: 110px; }
  .line-head { display: flex; align-items: center; gap: 1.5rem; padding-bottom: 2rem; border-bottom: 1px solid var(--rule); }
  .mark {
    display: grid;
    place-items: center;
    flex: none;
    width: 2.5rem;
    height: 2.5rem;
    border: 0;
    border-radius: 0;
    font-family: var(--f-latin);
    font-weight: 700;
    font-size: var(--t-lg);
    color: var(--amber);
  }
  .line-title { font-size: clamp(1.8rem, 3.2vw, 2.8rem); line-height: 1.25; max-width: 100%; text-wrap: balance; }

  .stages {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 1.5rem;
  }
  .stage {
    display: grid;
    grid-template-columns: minmax(0, .85fr) minmax(0, 1.15fr);
    grid-template-areas: 'copy visual';
    align-items: center;
    gap: clamp(1.5rem, 4vw, 3.5rem);
    padding: 1.5rem 0;
    border-bottom: 1px solid var(--rule-soft);
    align-content: start;
  }
  .stage:last-child { border-bottom: 0; }
  .stage-visual { grid-area: visual; min-width: 0; margin: 0; }
  .stage-copy { grid-area: copy; min-width: 0; }
  .stage-heading { display: grid; grid-template-columns: 2.5rem minmax(0, 1fr); gap: 1rem; align-items: baseline; }
  .idx { color: var(--amber); font-size: var(--t-sm); }
  .pic {
    display: block;
    width: 100%;
    aspect-ratio: 16 / 10;
    padding: 0;
    border: 1px solid var(--rule);
    background: var(--panel);
    cursor: zoom-in;
  }
  .pic.light { background: var(--plate); }
  .pic :global(img) { width: 100%; height: 100%; object-fit: contain; padding: clamp(1rem, 2vw, 1.75rem); }
  .pic.light :global(img) { mix-blend-mode: multiply; filter: saturate(.6) contrast(1.04); }
  .stage-visual figcaption { padding-top: .75rem; color: var(--ink-2); font-size: var(--t-xs); }
  .pic:hover + figcaption { color: var(--ink); }
  .stage-title { font-family: var(--f-cjk); font-size: clamp(1.5rem, 2.2vw, 2.1rem); font-weight: 400; line-height: 1.35; }
  :global(html[lang="en"]) .stage-title { font-family: var(--f-latin); font-weight: 600; }
  .stage-body { margin: .75rem 0 0 3.5rem; color: var(--ink-2); font-size: var(--t-md); line-height: 1.9; max-width: 68ch; }
  .after {
    margin: 2rem 0 0 3.5rem;
    padding: 1.25rem 0 1.25rem 1.5rem;
    border-left: 2px solid var(--amber);
    color: var(--ink-2);
    font-size: var(--t-sm);
  }
  @media (max-width: 900px) {
    .line-head { gap: 1rem; padding-bottom: 1.5rem; }
    .mark { width: 2.8rem; height: 2.8rem; font-size: var(--t-lg); }
    .stage { padding: 1.5rem 0; gap: 1.25rem; grid-template-columns: minmax(0, 1fr); grid-template-areas: 'copy' 'visual'; }
    .stage-heading { grid-template-columns: 2.5rem minmax(0, 1fr); }
    .stage-body { margin-top: .8rem; max-width: 60ch; }
  }
  @media (max-width: 540px) {
    .after { margin-left: 0; }
  }
</style>
