---
import { Image } from 'astro:assets';
import { sceneCopy } from '../data/content';
import { t, type Lang } from '../data/i18n';
import still from '../../materials/images/derived/site/cad-cutouts/engineer-full.png';

interface Props { lang: Lang }
const { lang } = Astro.props;
const L = sceneCopy.armExchange;
const times = [0, 1.4, 2.2, 3.7, 4.8, 5.2, 6.5];
---
<div class="exchange is-static" data-arm-exchange data-play={t(L.play, lang)} data-pause={t(L.pause, lang)} data-loading={t(L.loading, lang)} data-unavailable={t(L.unavailable, lang)}>
  <div class="exchange-view" data-view>
    <div class="exchange-still">
      <Image src={still} alt={t(L.staticAlt, lang)} width={1200} loading="lazy" />
    </div>
    <canvas data-canvas role="img" aria-label={t(L.canvasAlt, lang)}></canvas>
    <span class="scene-label mineral-label" data-mineral-label>{t(L.mineral, lang)}</span>
    <span class="scene-label station-label" data-station-label>{t(L.station, lang)}</span>
    <div class="view-label"><span class="phase" data-phase>{t(L.phases[0], lang)}</span><span class="illustration">{t(L.illustration, lang)}</span></div>
    <span class="scene-status" data-status role="status">{t(L.loading, lang)}</span>
    <span class="orbit-hint">{t(L.hint, lang)}</span>
    <p class="static-note">{t(L.staticNote, lang)}</p>
  </div>
  <fieldset class="exchange-controls" disabled>
    <legend class="sr-only">{t(L.timeline, lang)}</legend>
    <div class="transport">
      <button class="play" type="button" data-toggle aria-pressed="true"><span data-play-icon aria-hidden="true">Ⅱ</span><span data-play-label>{t(L.pause, lang)}</span></button>
      <label class="timeline"><span class="sr-only">{t(L.timeline, lang)}</span><input data-timeline type="range" min="0" max="7.2" step="0.01" value="0" /><span class="ticks" aria-hidden="true">{times.map((time) => <i style={`left:${time / 7.2 * 100}%`}></i>)}</span></label>
      <output class="time" data-time>0.00 s</output>
      <button type="button" class="reset" data-reset>{t(L.reset, lang)}</button>
    </div>
    <div class="phases" aria-label={t(L.stages, lang)}>
      {L.phases.map((phase, i) => <button type="button" data-keyframe={times[i]} data-phase-index={i} aria-current={i === 0 ? 'step' : undefined}>{t(phase, lang)}</button>)}
    </div>
    <div class="telemetry">
      <dl class="joints" aria-label={t(L.joints, lang)}>{Array.from({ length: 6 }, (_, i) => <div><dt>J{i + 1}</dt><dd data-joint={i}>0.0°</dd></div>)}</dl>
      <div class="envelope"><span>{t(L.envelope, lang)}</span><div><output data-envelope>—</output><span class="unit">mm</span><span class="extent-bar" aria-hidden="true"><i data-extent></i></span></div></div>
    </div>
  </fieldset>
  <p class="caption">{t(L.caption, lang)}</p>
</div>

<script>
  import { mountViewportScene } from '../scripts/lib/viewport-scene';
  document.querySelectorAll<HTMLElement>('[data-arm-exchange]').forEach(root => {
    const status = root.querySelector<HTMLElement>('[data-status]')!;
    mountViewportScene({
      root, view: root.querySelector<HTMLElement>('[data-view]')!,
      media: '(min-width: 761px) and (prefers-reduced-motion: no-preference)',
      async load(signal) {
        const { createArmExchange } = await import('../scripts/arm-exchange-scene');
        if (signal.aborted) return;
        return createArmExchange(root, import.meta.env.BASE_URL, signal);
      },
      loading() { root.classList.remove('is-static', 'is-fallback'); root.classList.add('is-loading'); status.textContent = root.dataset.loading!; },
      ready() { root.classList.remove('is-loading'); root.classList.add('is-ready'); },
      reset() {
        root.classList.remove('is-ready', 'is-loading'); root.classList.add('is-static');
        const canvas = root.querySelector('canvas')!; canvas.replaceWith(canvas.cloneNode(false));
        root.querySelector<HTMLFieldSetElement>('fieldset')!.disabled = true;
        delete root.dataset.ready;
      },
      failed(error) { root.classList.add('is-fallback'); status.textContent = root.dataset.unavailable!; console.warn('Arm exchange unavailable', error); },
    });
  });
</script>

<style>
  .exchange { --scene-inset: 1.25rem; margin-top: .5rem; border: 1px solid var(--rule); background: var(--ground); }
  .exchange-view { height: clamp(420px, 34vw, 500px); position: relative; overflow: hidden; }
  .exchange-still, canvas { position: absolute; inset: 0; width: 100%; height: 100%; }
  .exchange-still { background: var(--plate); display: grid; place-items: center; }
  .exchange-still img { width: 100%; height: 100%; object-fit: contain; mix-blend-mode: multiply; }
  canvas { opacity: 0; pointer-events: none; touch-action: none; cursor: grab; }
  canvas:active { cursor: grabbing; }
  .is-ready canvas { opacity: 1; pointer-events: auto; }
  .is-ready .exchange-still { visibility: hidden; }
  .view-label { position: absolute; top: 1.1rem; left: var(--scene-inset); right: var(--scene-inset); display: flex; justify-content: space-between; align-items: center; gap: 1rem; pointer-events: none; }
  .phase { border-left: 3px solid var(--amber); padding-left: .65rem; font-size: var(--t-sm); color: var(--ink); }
  .illustration { color: var(--ink-2); font-size: var(--t-xs); background: var(--ground); padding: .3rem .5rem; }
  .scene-status { position: absolute; bottom: 1rem; left: var(--scene-inset); padding: .4rem .65rem; background: var(--ground); color: var(--ink-2); font-size: var(--t-xs); }
  .orbit-hint { position: absolute; bottom: 1rem; right: var(--scene-inset); color: var(--ink-3); font-size: var(--t-xs); pointer-events: none; display: none; }
  .is-ready .scene-status { display: none; }
  .is-ready .orbit-hint { display: block; }
  .scene-label { display: none; position: absolute; top: 0; left: 0; pointer-events: none; font-size: .65rem; white-space: nowrap; padding: .2rem .4rem; background: var(--ground); color: var(--ink-2); }
  .is-ready .scene-label { display: block; }
  .station-label { color: var(--amber); border-bottom: 1px solid var(--amber); }
  /* Keep the same desktop rows while the viewport scheduler releases the GLB. */
  fieldset { margin: 0; padding: .75rem var(--scene-inset); min-width: 0; border: 0; border-top: 1px solid var(--rule); height: 130px; display: grid; grid-template-rows: 36px 28px 24px; gap: 8px; visibility: hidden; }
  .is-ready fieldset { visibility: visible; }
  .transport { display: flex; align-items: center; gap: 1rem; }
  button { color: var(--ink-2); background: transparent; border: 1px solid var(--rule); padding: .45rem .7rem; cursor: pointer; font: inherit; font-size: var(--t-xs); }
  button:hover { color: var(--amber); border-color: var(--amber); }
  button:focus-visible, input:focus-visible { outline: 2px solid var(--amber); outline-offset: 4px; }
  .play { color: var(--amber); min-width: 6rem; display: flex; justify-content: center; gap: .6rem; }
  .play, .reset { height: 36px; }
  .play [data-play-icon] { min-width: 1ch; font-family: var(--f-mono); }
  .timeline { flex: 1; position: relative; padding: .6rem 0; }
  .timeline input { display: block; width: 100%; margin: 0; accent-color: var(--amber); cursor: pointer; }
  .ticks { position: absolute; left: 8px; right: 8px; bottom: 0; pointer-events: none; }
  .ticks i { position: absolute; height: 4px; width: 1px; background: var(--ink-3); }
  .time { font: var(--t-xs) var(--f-mono); color: var(--amber); min-width: 6.5ch; text-align: right; }
  .phases { display: grid; grid-template-columns: repeat(7, minmax(0, 1fr)); gap: .5rem; }
  .phases button { border: 0; border-bottom: 1px solid var(--rule); padding: .2rem .15rem .35rem; white-space: nowrap; }
  .phases button[aria-current] { color: var(--amber); border-color: var(--amber); }
  .telemetry { display: grid; grid-template-columns: minmax(0, 1fr) 260px; align-items: center; gap: 1.25rem; }
  .joints { margin: 0; display: grid; grid-template-columns: repeat(6, minmax(0, 1fr)); gap: .5rem; font-family: var(--f-mono); font-variant-numeric: tabular-nums; }
  .joints > div { display: flex; align-items: baseline; gap: .45rem; white-space: nowrap; }
  .joints dt { font-size: .65rem; color: var(--ink-3); }
  .joints dd { margin: 0; font-size: var(--t-xs); color: var(--ink-2); }
  .envelope { display: flex; align-items: center; gap: .75rem; padding-left: 1.25rem; border-left: 1px solid var(--rule); }
  .envelope > span { font-size: .65rem; color: var(--ink-3); }
  .envelope > div { display: flex; flex: 1; align-items: center; gap: .4rem; }
  .envelope output { color: var(--amber); font: var(--t-xs) var(--f-mono); min-width: 4ch; }
  .unit { font: .65rem var(--f-mono); color: var(--ink-3); }
  .extent-bar { flex: 1; height: 3px; background: var(--rule); }
  .extent-bar i { display: block; width: 100%; height: 100%; background: var(--amber); transform-origin: left; }
  .caption { margin: 0; padding: 0 var(--scene-inset) .75rem; font-size: var(--t-xs); line-height: 1.6; color: var(--ink-3); max-width: none; }
  .static-note { position: absolute; bottom: 1rem; left: var(--scene-inset); right: var(--scene-inset); display: none; margin: 0; padding: .4rem .65rem; background: var(--ground); font-size: var(--t-xs); line-height: 1.6; color: var(--ink-2); max-width: none; }
  .is-static:not(.is-fallback) .static-note { display: block; }
  .is-static:not(.is-fallback) .scene-status { display: none; }
  .is-static .phase { display: none; }
  .sr-only { position: absolute; width: 1px; height: 1px; padding: 0; overflow: hidden; clip: rect(0, 0, 0, 0); white-space: nowrap; }
  @media (min-width: 761px) and (max-width: 1000px) {
    .telemetry { grid-template-columns: minmax(0, 1fr) 210px; gap: .75rem; }
    .joints > div { gap: .25rem; }
    .joints dd { font-size: .65rem; }
    .envelope { gap: .5rem; padding-left: .75rem; }
  }
  @media (max-width: 760px) {
    .exchange { --scene-inset: .75rem; }
    .exchange-view { height: 360px; }
    .view-label { justify-content: flex-end; top: .75rem; left: .75rem; right: .75rem; }
    fieldset, canvas { display: none !important; }
    .exchange-still { visibility: visible !important; }
    .static-note { display: block; }
    .caption { padding-top: .75rem; border-top: 1px solid var(--rule); }
  }
  @media (prefers-reduced-motion: reduce) {
    fieldset, canvas { display: none !important; }
    .exchange-still { visibility: visible !important; }
    .static-note { display: block; }
    .caption { padding-top: .75rem; border-top: 1px solid var(--rule); }
  }
</style>
