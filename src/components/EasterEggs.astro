---
import { engineer } from '../data/content';
import { t, type Lang } from '../data/i18n';

interface Props { lang: Lang }
const { lang } = Astro.props;
const L = engineer.eggs;
const base = import.meta.env.BASE_URL;
---

<section id="easter-eggs" class="wrap eggs" aria-labelledby="eggs-title">
  <header class="eggs-head">
    <span class="head-rule" aria-hidden="true"></span>
    <h2 id="eggs-title" class="display">{t(L.title, lang)}</h2>
  </header>

  <div class="egg-grid">
    {L.items.map((egg) => (
      <article class:list={['egg', egg.layout]}>
        <div class="frame">
          <video
            data-egg-video
            data-src={`${base}video/${egg.file}`}
            poster={`${base}video/${egg.poster}`}
            muted
            loop
            playsinline
            autoplay
            preload="none"
            aria-label={t(egg.alt, lang)}
          ></video>
          <span class="corner tl" aria-hidden="true"></span>
          <span class="corner br" aria-hidden="true"></span>
          <span class="pending" data-pending>{t(L.pending, lang)}</span>

          <div class="hud">
            <span class="index num">{egg.index}</span>
            <dl class="details">
              <div><dt>{t(L.matchLabel, lang)}</dt><dd>{t(egg.match, lang)}</dd></div>
              <div><dt>{t(L.opponentLabel, lang)}</dt><dd>{t(egg.opponent, lang)}</dd></div>
              <div><dt>{t(L.actionLabel, lang)}</dt><dd>{t(egg.action, lang)}</dd></div>
            </dl>
            <div class="source-row">
              <span>{t(L.sourceLabel, lang)}：{t(egg.source, lang)}</span>
              <a href={egg.href} rel="noopener">{t(L.watch, lang)}</a>
            </div>
          </div>
        </div>
      </article>
    ))}
  </div>
</section>

<script>
  const videos = [...document.querySelectorAll<HTMLVideoElement>('.eggs [data-egg-video]')];
  const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  const loadVideo = (video: HTMLVideoElement) => {
    if (!video.src) video.src = video.dataset.src!;
    if (!reducedMotion) video.play().catch(() => {});
  };

  videos.forEach((video) => {
    if (reducedMotion) {
      video.controls = true;
      video.removeAttribute('autoplay');
    }
    video.addEventListener('error', () => {
      video.dataset.failed = 'true';
      const pending = video.closest('.frame')?.querySelector<HTMLElement>('[data-pending]');
      if (pending) pending.hidden = false;
    });
    video.addEventListener('loadeddata', () => {
      const pending = video.closest('.frame')?.querySelector<HTMLElement>('[data-pending]');
      if (pending) pending.hidden = true;
    });
  });

  if ('IntersectionObserver' in window) {
    const observer = new IntersectionObserver((entries) => {
      entries.forEach(({ target, isIntersecting }) => {
        const video = target as HTMLVideoElement;
        if (isIntersecting && video.dataset.failed !== 'true') loadVideo(video);
        else video.pause();
      });
    }, { rootMargin: '120px 0px' });
    videos.forEach((video) => observer.observe(video));
  } else {
    videos.forEach((video) => {
      if (!reducedMotion) loadVideo(video);
      else video.src = video.dataset.src!;
    });
  }
</script>

<style>
  .eggs { padding-top: clamp(4rem, 8vw, 7rem); scroll-margin-top: 5.5rem; }
  .eggs-head { display: flex; align-items: center; gap: 1rem; margin-bottom: 1.5rem; }
  .eggs-head h2 { font-size: clamp(2rem, 3.2vw, 2.8rem); }
  .head-rule { width: 2.4rem; height: 3px; flex: none; background: var(--amber); }
  .egg-grid {
    display: grid;
    grid-template-columns: minmax(15rem, .72fr) minmax(0, 1.28fr);
    grid-template-rows: auto auto;
    align-items: stretch;
    gap: clamp(.8rem, 1.5vw, 1.25rem);
  }
  .egg { min-width: 0; }
  .egg.portrait { grid-row: 1 / span 2; }
  .frame {
    position: relative;
    height: 100%;
    min-height: 16rem;
    overflow: hidden;
    isolation: isolate;
    border: 1px solid var(--rule);
    background: var(--panel);
  }
  .landscape .frame { aspect-ratio: 2 / 1; }
  .portrait .frame { aspect-ratio: 9 / 16; }
  video { position: absolute; inset: 0; z-index: -1; width: 100%; height: 100%; object-fit: cover; background: var(--ground); }
  .portrait video { object-position: center; }
  .frame::after { content: ''; position: absolute; z-index: -1; inset: 25% 0 0; background: linear-gradient(180deg, transparent, rgba(7, 13, 23, .92)); pointer-events: none; }
  .corner { position: absolute; width: 18px; height: 18px; border: 2px solid var(--amber); pointer-events: none; }
  .corner.tl { top: 9px; left: 9px; border-right: 0; border-bottom: 0; }
  .corner.br { right: 9px; bottom: 9px; border-left: 0; border-top: 0; }
  .pending { position: absolute; top: .8rem; right: .8rem; padding: .25rem .45rem; border-left: 2px solid var(--amber); color: var(--ink-2); background: rgba(7, 13, 23, .82); font-size: var(--t-xs); }
  .hud { position: absolute; inset: auto 0 0; display: grid; grid-template-columns: auto minmax(0, 1fr); align-items: end; gap: .7rem 1rem; padding: clamp(.8rem, 1.5vw, 1.25rem); }
  .index { align-self: start; color: var(--amber); font-size: clamp(1.8rem, 3vw, 2.6rem); line-height: 1; }
  .details { display: grid; gap: .32rem; min-width: 0; margin: 0; }
  .details div { display: grid; grid-template-columns: 3.5rem minmax(0, 1fr); gap: .65rem; align-items: baseline; }
  .details dt { color: var(--ink-3); font-size: var(--t-xs); }
  .details dd { min-width: 0; margin: 0; color: var(--ink); font-size: var(--t-sm); line-height: 1.5; }
  .source-row { grid-column: 1 / -1; display: flex; justify-content: space-between; flex-wrap: wrap; gap: .4rem 1rem; padding-top: .6rem; border-top: 1px solid rgba(231, 238, 246, .18); color: var(--ink-3); font-size: var(--t-xs); }
  .source-row a { color: var(--amber); text-underline-offset: 3px; }
  .source-row a:focus-visible { outline: 2px solid var(--amber); outline-offset: 3px; }

  @media (max-width: 760px) {
    .eggs { padding-top: 4rem; }
    .egg-grid { grid-template-columns: minmax(0, 1fr); grid-template-rows: auto; gap: 1rem; }
    .egg.portrait { grid-row: auto; }
    .portrait .frame { width: min(100%, 28rem); justify-self: center; }
    .landscape .frame { aspect-ratio: 16 / 9; min-height: 13rem; }
  }
</style>
