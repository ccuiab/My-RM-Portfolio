---
import { engineer, engineerShowcase } from '../data/content';
import { t, type Lang } from '../data/i18n';

interface Props { lang: Lang }
const { lang } = Astro.props;
const L = engineer.eggs;
const base = import.meta.env.BASE_URL;
---

<section id="easter-eggs" class="wrap eggs" aria-labelledby="eggs-title">
  <header class="eggs-head">
    <span class="head-rule" aria-hidden="true"></span>
    <h2 id="eggs-title" class="display">{t(L.title, lang)}</h2>
  </header>

  <div class="egg-grid">
    {L.items.map((egg, i) => (
      <article class:list={['egg', egg.layout]} style={`--reveal-delay: ${i * 90}ms`}>
        <div class="frame">
          <video
            data-egg-video
            data-src={`${base}video/${egg.file}`}
            poster={`${base}video/${egg.poster}`}
            muted
            loop
            playsinline
            preload="none"
            aria-label={t(egg.alt, lang)}
          ></video>
          <span class="corner tl" aria-hidden="true"></span>
          <span class="corner br" aria-hidden="true"></span>
          <span class="pending" data-pending hidden>{t(L.pending, lang)}</span>
        </div>
        <div class="playback">
          <button type="button" data-playback data-play={t(L.play, lang)} data-pause={t(L.pause, lang)} aria-label={t(L.pause, lang)}>{t(L.pause, lang)}</button>
          <input data-seek type="range" min="0" max="100" step="0.1" value="0" aria-label={t(L.seek, lang)} disabled />
        </div>
        <div class="hud">
          <span class="index num">{egg.index}</span>
          <div class="caption">
            <h3>{t(egg.title, lang)}</h3>
            <details class="clip-details"><summary>{t(engineerShowcase.clipDetails, lang)}</summary><dl class="details">
              <div><dt>{t(L.matchLabel, lang)}</dt><dd>{t(egg.match, lang)}</dd></div>
              {egg.opponent && <div><dt>{t(L.opponentLabel, lang)}</dt><dd>{t(egg.opponent, lang)}</dd></div>}
              <div><dt>{t(L.actionLabel, lang)}</dt><dd>{t(egg.action, lang)}</dd></div>
            </dl></details>
          </div>
          <div class="source-row">
            <span>{t(L.sourceLabel, lang)}：{t(egg.source, lang)}</span>
            <a href={egg.href} target="_blank" rel="noopener noreferrer">{t('heroHref' in egg ? L.engineerWatch : 'broadcastHref' in egg ? L.povWatch : L.watch, lang)}</a>
            {'heroHref' in egg && <a href={egg.heroHref} target="_blank" rel="noopener noreferrer">{t(L.heroWatch, lang)}</a>}
            {'broadcastHref' in egg && <a href={egg.broadcastHref} target="_blank" rel="noopener noreferrer">{t(L.broadcastWatch, lang)}</a>}
          </div>
        </div>
      </article>
    ))}
  </div>
</section>

<script>
  const videos = [...document.querySelectorAll<HTMLVideoElement>('.eggs [data-egg-video]')];
  const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const section = document.querySelector<HTMLElement>('.eggs');

  // Open the frames in one HUD shutter sequence when the ending enters view.
  if (section && !reducedMotion && 'IntersectionObserver' in window) {
    section.classList.add('will-reveal');
    const reveal = new IntersectionObserver(([entry]) => {
      if (!entry.isIntersecting) return;
      section.classList.add('is-visible');
      reveal.disconnect();
    }, { threshold: 0, rootMargin: '0px 0px -12% 0px' });
    reveal.observe(section);
  }

  const loadVideo = (video: HTMLVideoElement) => {
    if (!video.src) video.src = video.dataset.src!;
    if (!reducedMotion && video.dataset.userPaused !== 'true' && !document.hidden) video.play().catch(() => {});
  };

  videos.forEach((video) => {
    const egg = video.closest('.egg')!;
    const button = egg.querySelector<HTMLButtonElement>('[data-playback]')!;
    const seek = egg.querySelector<HTMLInputElement>('[data-seek]')!;
    const updatePlayback = () => {
      button.textContent = video.paused ? button.dataset.play! : button.dataset.pause!;
      button.setAttribute('aria-label', button.textContent);
    };
    updatePlayback();
    button.addEventListener('click', () => {
      if (video.paused) {
        video.dataset.userPaused = 'false';
        if (!video.src) video.src = video.dataset.src!;
        video.play().catch(() => {});
      } else {
        video.dataset.userPaused = 'true';
        video.pause();
      }
    });
    video.addEventListener('play', updatePlayback);
    video.addEventListener('pause', updatePlayback);
    video.addEventListener('loadedmetadata', () => { seek.disabled = false; });
    video.addEventListener('timeupdate', () => {
      if (Number.isFinite(video.duration)) seek.value = String(video.currentTime / video.duration * 100);
    });
    seek.addEventListener('input', () => {
      if (Number.isFinite(video.duration)) video.currentTime = Number(seek.value) / 100 * video.duration;
    });
    if (reducedMotion) {
      video.removeAttribute('autoplay');
    }
    updatePlayback();
    video.addEventListener('error', () => {
      video.dataset.failed = 'true';
      const pending = video.closest('.frame')?.querySelector<HTMLElement>('[data-pending]');
      if (pending) pending.hidden = false;
    });
    video.addEventListener('loadeddata', () => {
      const pending = video.closest('.frame')?.querySelector<HTMLElement>('[data-pending]');
      if (pending) pending.hidden = true;
    });
  });

  if ('IntersectionObserver' in window) {
    const observer = new IntersectionObserver((entries) => {
      entries.forEach(({ target, isIntersecting }) => {
        const video = target as HTMLVideoElement;
        video.dataset.inView = String(isIntersecting);
        if (isIntersecting && video.dataset.failed !== 'true') loadVideo(video);
        else video.pause();
      });
    }, { rootMargin: '120px 0px' });
    videos.forEach((video) => observer.observe(video));
  } else {
    videos.forEach((video) => {
      video.dataset.inView = 'true';
      if (!reducedMotion) loadVideo(video);
      else video.src = video.dataset.src!;
    });
  }
  document.addEventListener('visibilitychange', () => {
    videos.forEach((video) => {
      if (document.hidden) video.pause();
      else if (video.dataset.inView === 'true' && video.dataset.failed !== 'true') loadVideo(video);
    });
  });
</script>

<style>
  .eggs { padding-top: calc(var(--section-space) + 1rem); scroll-margin-top: 6rem; }
  .eggs-head { display: flex; align-items: baseline; gap: 1rem; padding-top: 2rem; margin-bottom: 2rem; border-top: 1px solid var(--rule); }
  .eggs-head h2 { font-size: clamp(2rem, 3.2vw, 2.8rem); }
  .head-rule { width: 2.4rem; height: 3px; flex: none; align-self: center; background: var(--amber); }
  .egg-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    align-items: stretch;
    gap: 2.5rem 1.25rem;
  }
  .egg { min-width: 0; display: grid; grid-template-rows: auto auto 1fr; }
  .will-reveal .egg { opacity: 0; clip-path: inset(0 0 100% 0); transition: clip-path .65s ease, opacity .4s ease; transition-delay: var(--reveal-delay); }
  .will-reveal.is-visible .egg { opacity: 1; clip-path: inset(0); }
  .frame {
    position: relative;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    isolation: isolate;
    border: 1px solid var(--rule);
    background: var(--panel);
  }
  video { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: contain; background: var(--ground); }
  .corner { position: absolute; width: 18px; height: 18px; border: 2px solid var(--amber); pointer-events: none; }
  .corner.tl { top: 9px; left: 9px; border-right: 0; border-bottom: 0; }
  .corner.br { right: 9px; bottom: 9px; border-left: 0; border-top: 0; }
  .pending { position: absolute; top: .8rem; right: .8rem; padding: .25rem .45rem; border-left: 2px solid var(--amber); color: var(--ink-2); background: rgba(7, 13, 23, .82); font-size: var(--t-xs); }
  .playback { display: flex; align-items: center; gap: .8rem; min-width: 0; padding-top: .7rem; }
  .playback button { flex: none; min-width: 3.6rem; min-height: 2rem; padding: .2rem .5rem; border: 1px solid var(--rule); color: var(--amber); background: var(--panel); font: inherit; font-size: var(--t-xs); cursor: pointer; }
  .playback input { width: 0; min-width: 0; flex: 1; accent-color: var(--amber); cursor: pointer; }
  .playback :is(button, input):focus-visible { outline: 2px solid var(--amber); outline-offset: 3px; }
  .hud { display: grid; grid-template-columns: auto minmax(0, 1fr); grid-template-rows: 1fr auto; gap: 1rem .75rem; padding: 1.25rem 0 0; }
  .index { align-self: start; color: var(--amber); font-size: 1.8rem; line-height: 1; }
  .caption { min-width: 0; }
  .caption h3 { margin: 0 0 .8rem; color: var(--ink); font-size: clamp(1.2rem, 1.65vw, 1.5rem); line-height: 1.2; }
  .clip-details summary { cursor: pointer; color: var(--ink-3); font-size: var(--t-xs); margin-bottom: .6rem; }
  .details { display: grid; align-content: start; gap: .4rem; min-width: 0; margin: 0; }
  .details div { display: grid; grid-template-columns: 2.25rem minmax(0, 1fr); gap: .5rem; align-items: baseline; }
  :global(html[lang="en"]) .details div { grid-template-columns: 4.6rem minmax(0, 1fr); }
  .details dt { color: var(--ink-3); font-size: var(--t-xs); }
  .details dd { min-width: 0; margin: 0; color: var(--ink); font-size: var(--t-sm); line-height: 1.5; }
  .source-row { grid-column: 1 / -1; display: grid; grid-template-rows: 1fr auto; gap: .65rem; padding-top: .8rem; border-top: 1px solid var(--rule); color: var(--ink-3); font-size: var(--t-xs); line-height: 1.65; }
  :global(html[lang="en"]) .source-row { min-height: 6.5rem; }
  .source-row a { justify-self: start; align-self: end; }
  .source-row a { color: var(--amber); text-underline-offset: 3px; }
  .source-row a:focus-visible { outline: 2px solid var(--amber); outline-offset: 3px; }

  @media (max-width: 760px) {
    .eggs { scroll-margin-top: 7rem; }
    .eggs-head { margin-bottom: 1.75rem; }
    .egg-grid { grid-template-columns: minmax(0, 1fr); gap: 2rem; }
    .egg { grid-template-rows: auto auto 1fr; }
    .details div { grid-template-columns: 3rem minmax(0, 1fr); }
    .hud { gap: 1rem; }
  }
  @media (prefers-reduced-motion: reduce) {
    .will-reveal .egg { opacity: 1; clip-path: none; }
  }
</style>
