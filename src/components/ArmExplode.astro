---
import { existsSync } from 'node:fs';
import { join } from 'node:path';
import { Image } from 'astro:assets';
import { t, type Lang } from '../data/i18n';
import { sceneCopy } from '../data/content';
import { ARM_STUDY_ORDER } from '../scripts/arm-study-story';
import fallback from '../../materials/images/derived/site/cad-cutouts/arm-exploded.png';
interface Props { lang: Lang }
const {lang}=Astro.props;
const L=sceneCopy.armExplode;
const hasModel=existsSync(join(process.cwd(),'materials/models/derived/web/arm-parts.glb'));
const copy={climb:t(L.climbTitle,lang),climbDescription:t(L.climbDescription,lang),climbFeatures:L.climbFeatures.map(x=>t(x,lang)),pathNames:L.pathNames.map(x=>t(x,lang)),limitBoundary:t(L.limitBoundary,lang),workspaceBoundary:t(L.workspaceBoundary,lang),finale:t(L.finaleTitle,lang),finaleDescription:t(L.finaleDescription,lang),overview:t(L.overview,lang),caption:t(L.caption,lang),names:L.groupNames.map(n=>t(n,lang)),descriptions:L.descriptions.map(n=>t(n,lang)),features:L.features.map(items=>items.map(n=>t(n,lang))),routes:L.routeSteps.map(items=>items.map(n=>t(n,lang))),phases:Object.fromEntries(Object.entries(L.phase).map(([key,value])=>[key,t(value,lang)]))};
---
<section class="explode" data-arm-explode data-model={hasModel?'1':''} data-copy={JSON.stringify(copy)} data-base={import.meta.env.BASE_URL}>
  <div class="view">
    <div class="still"><Image src={fallback} alt={t(L.alt,lang)} widths={[900,1600]} sizes="100vw" data-static-image /></div>
    <canvas class="three" data-lenis-prevent-wheel tabindex="0" role="img" aria-label={t(L.hint,lang)}></canvas>
    <img class="rm-watermark" data-rm-watermark src={`${import.meta.env.BASE_URL}robomaster-wordmark.png`} alt="" aria-hidden="true" width="122" height="14" hidden />
    <div class="study-transition" data-study-transition aria-hidden="true"></div>
    <div class="shot-heading"><span data-shot-phase hidden></span><strong data-shot-title>{t(L.overview,lang)}</strong></div>
    <div class="feature-labels" aria-hidden="true">{[0,1,2].map(i=><span data-feature-label={i}></span>)}</div>
    <div class="path-legend" data-path-legend hidden>{L.pathNames.map((name,i)=><span data-path-motor={i}>{t(name,lang)}</span>)}</div>
    <span class="limit-caption" data-limit-caption hidden>{t(L.limitBoundary,lang)}</span>
    <div class="route-labels" aria-hidden="true">{Array.from({length:14},(_,i)=><span data-route-label={i}>{i+1}</span>)}</div>
    <p class="status" role="status" data-status data-loading={t(sceneCopy.module.loading,lang)} data-failed={t(sceneCopy.module.failed,lang)} hidden></p>
    <div class="fallback-tools"><span>{t(L.fallback,lang)}</span><select data-static-select aria-label={t(L.selectGroup,lang)}><option value="overview">{t(L.overview,lang)}</option>{ARM_STUDY_ORDER.map(id=><option value={id}>{t(L.groupNames[id],lang)}</option>)}</select></div>
  </div>
  <fieldset class="controls" disabled>
    <legend class="sr-only">{t(L.controls,lang)}</legend>
    <div class="buttons">
      <button type="button" data-play aria-pressed="true" data-start={t(L.play,lang)} data-stop={t(L.pause,lang)}>{t(L.pause,lang)}</button>
      <button type="button" data-replay>{t(L.replay,lang)}</button>
      <button type="button" data-assembly>{t(L.assemble,lang)}</button>
      <button type="button" data-reset-view>{t(L.reset,lang)}</button>
    </div>
    <label class="timeline"><span class="sr-only">{t(L.progress,lang)}</span><input type="range" min="0" max="1000" step="1" value="0" data-story-range /><output data-story-time>0.0 s</output></label>
  </fieldset>
  <nav class="chapters" aria-label={t(L.progress,lang)}>{L.chapters.map((name,i)=><button type="button" data-story-step={i} aria-pressed="false">{t(name,lang)}</button>)}</nav>
  <p class="description" data-story-description hidden></p>
  <details class="route-key" data-route-key hidden><summary>{t(L.route,lang)}</summary><ol data-route-list></ol></details>
</section>
<script>
  import {mountViewportScene} from '../scripts/lib/viewport-scene';
  document.querySelectorAll<HTMLElement>('[data-arm-explode]').forEach(root=>{
    const status=root.querySelector<HTMLElement>('[data-status]')!;
    const controls=root.querySelector<HTMLFieldSetElement>('.controls')!;
    const image=root.querySelector<HTMLImageElement>('[data-static-image]')!,overview=image.src;
    const staticSelect=root.querySelector<HTMLSelectElement>('[data-static-select]')!,uiCopy=JSON.parse(root.dataset.copy!);
    const syncStatic=()=>{image.removeAttribute('srcset');image.src=staticSelect.value==='overview'?overview:`${root.dataset.base}arm-study/detail-${staticSelect.value}.png`;image.alt=staticSelect.selectedOptions[0].textContent!;root.querySelector<HTMLElement>('[data-story-description]')!.textContent=staticSelect.value==='overview'?uiCopy.caption:uiCopy.descriptions[Number(staticSelect.value)];root.querySelector<HTMLDetailsElement>('[data-route-key]')!.hidden=true;};
    staticSelect.addEventListener('change',syncStatic);
    if(root.dataset.model!=='1')return;
    mountViewportScene({root,view:root.querySelector<HTMLElement>('.view')!,media:'(prefers-reduced-motion: no-preference)',
      async load(signal){const {loadArmExplodeScene}=await import('../scripts/arm-explode-scene');if(!signal.aborted)return loadArmExplodeScene(root,import.meta.env.BASE_URL,signal);},
      loading(){root.classList.add('is-loading');status.hidden=false;status.textContent=status.dataset.loading!;},
      ready(){root.classList.remove('is-loading');root.classList.add('has-3d');root.dataset.ready='true';controls.disabled=false;status.hidden=true;},
      reset(){root.classList.remove('has-3d','is-loading');delete root.dataset.ready;controls.disabled=true;status.hidden=true;syncStatic();const canvas=root.querySelector('canvas.three')!;canvas.replaceWith(canvas.cloneNode(false));},
      failed(error){root.dataset.failedState='true';status.hidden=false;status.textContent=status.dataset.failed!;console.warn('Arm presentation unavailable',error);},
    });
  });
</script>
<style>
  .explode { display:grid;gap:.75rem;min-width:0; }
  .view { position:relative;height:clamp(420px,38vw,540px);overflow:hidden;background:var(--panel); }
  .still,.three { position:absolute;inset:0;width:100%;height:100%; }
  .still :global(img) { width:100%;height:100%;object-fit:contain; }
  .three { visibility:hidden;pointer-events:none;touch-action:none;cursor:grab; }
  .three:active { cursor:grabbing; }.has-3d .three { visibility:visible;pointer-events:auto; }.has-3d .still { visibility:hidden; }
  .rm-watermark { position:absolute;right:1rem;top:1rem;width:100px;height:auto;filter:invert(1);mix-blend-mode:screen;opacity:.32;pointer-events:none;z-index:4; }
  .study-transition { position:absolute;inset:0;background:var(--panel);opacity:0;pointer-events:none;z-index:6;display:none; }.has-3d .study-transition { display:block; }
  .shot-heading { position:absolute;top:1rem;left:1.1rem;display:none;gap:.25rem;pointer-events:none; }
  .has-3d .shot-heading { display:grid; }
  .shot-heading span { color:var(--ink-3);font-size:var(--t-xs); }.shot-heading strong { color:var(--amber);font-size:var(--t-sm);font-weight:500;background:rgba(7,13,23,.65);padding:.1rem .35rem; }
  .controls { display:none;align-items:center;gap:1rem;margin:0;padding:0;border:0;min-width:0; }.has-3d .controls { display:flex; }
  .buttons { display:flex;flex-wrap:wrap;gap:.45rem;flex-shrink:0; }
  button,select { border:1px solid var(--rule);padding:.5rem .7rem;color:var(--ink-2);background:var(--ground);font:inherit;font-size:var(--t-xs);cursor:pointer; }
  button:hover,button[aria-pressed="true"] { border-color:var(--amber);color:var(--amber); }
  .timeline { display:flex;align-items:center;gap:.65rem;flex:1;min-width:0; }input { flex:1;min-width:0;accent-color:var(--amber); }output { color:var(--amber);font:var(--t-xs) var(--f-mono);min-width:7ch;text-align:right; }
  .chapters { display:none;gap:.4rem;border-bottom:1px solid var(--rule); }.has-3d .chapters { display:flex; }
  .chapters button { flex:1;border:0;border-bottom:2px solid transparent;padding:.5rem .25rem;background:transparent;font-size:11px;white-space:nowrap; }
  .chapters button[aria-pressed="true"] { border-bottom-color:var(--amber); }
  .description { margin:0;max-width:88ch;color:var(--ink-2);font-size:var(--t-sm);line-height:1.75;min-height:3.5em; }
  .hint,.design-note { margin:0;max-width:100ch;color:var(--ink-3);font-size:var(--t-xs);line-height:1.7; }
  .design-note { padding-left:.8rem;border-left:2px solid var(--amber); }
  .route-key { font-size:var(--t-xs);color:var(--ink-3); }.route-key summary { cursor:pointer; }.route-key ol { display:flex;flex-wrap:wrap;gap:.35rem 1.7rem;padding-left:1.5rem; }.route-key li::marker { color:var(--amber); }
  .feature-labels,.route-labels { position:absolute;inset:0;pointer-events:none;overflow:hidden;display:none; }.has-3d .feature-labels,.has-3d .route-labels { display:block; }
  .feature-labels span { position:absolute;top:0;left:0;padding:.2rem .4rem;background:rgba(7,13,23,.85);color:var(--amber);font-size:11px;white-space:nowrap; }
  .route-labels { opacity:0;transition:opacity .2s; }.explode:has(.route-key[open]) .route-labels { opacity:1; }
  .route-labels span { position:absolute;top:0;left:0;width:19px;height:19px;border:1px solid var(--amber);border-radius:50%;color:var(--amber);background:var(--ground);text-align:center;font:11px/17px var(--f-mono); }
  .status,.fallback-tools { position:absolute;bottom:.8rem;left:1rem;right:1rem;margin:0;color:var(--ink-2);font-size:var(--t-xs); }.fallback-tools { display:flex;align-items:center;justify-content:space-between;gap:.5rem; }.has-3d .fallback-tools { display:none; }
  .limit-caption { white-space:pre-line; }
  [hidden] { display:none!important; }.sr-only { position:absolute;width:1px;height:1px;overflow:hidden;clip:rect(0,0,0,0); }
  @media(max-width:767px) { .view { height:340px; }.controls { flex-wrap:wrap;gap:.6rem; }.timeline { flex-basis:100%; }.chapters { overflow-x:auto; }.chapters button { min-width:64px; }.description { font-size:var(--t-xs); }.feature-labels span { font-size:10px; }.shot-heading { top:.6rem;left:.65rem; } }
</style>

<style>
.path-legend{position:absolute;bottom:14px;left:16px;display:flex;flex-wrap:wrap;max-width:calc(100% - 32px);gap:4px 14px;font-size:11px;pointer-events:none}.path-legend[hidden],.limit-caption[hidden]{display:none}.path-legend span{border-left:3px solid currentColor;padding-left:7px;background:#0b1422cc}.path-legend span:nth-child(1){color:var(--amber)}.path-legend span:nth-child(2){color:#31ffb9}.path-legend span:nth-child(3){color:#c96bff}.path-legend span:nth-child(4){color:#e1f3ff}.limit-caption{max-width:calc(100% - 32px);line-height:1.5;position:absolute;bottom:16px;left:16px;color:var(--amber);font-size:11px;background:#0b1422dd}
</style>
