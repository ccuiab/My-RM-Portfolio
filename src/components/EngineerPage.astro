---
import Base from '../layouts/Base.astro';
import ModuleMedia from './ModuleMedia.astro';
import EngineerChapter from './EngineerChapter.astro';
import EngineerMission from './EngineerMission.astro';
import OfficialFilm from './OfficialFilm.astro';
import EasterEggs from './EasterEggs.astro';
import ArmExplode from './ArmExplode.astro';
import Lightbox from './Lightbox.astro';
import NextSheet from './NextSheet.astro';
import { engineer, hero, sceneCopy, engineerShowcase as copy } from '../data/content';
import { t, type Lang } from '../data/i18n';

interface Props { lang: Lang }
const { lang } = Astro.props;
const p = engineer;
---
<Base lang={lang} slug={p.slug} title={p.short} description={p.lede}>
  <div class="engineer-showcase">
  <header class="showcase-hero" data-engineer-header>
    <div class="hero-model"><ModuleMedia pic={{ ...p.assembly, model: 'engineer.glb' }} lang={lang} /></div>
    <div class="wrap hero-heading">
      <p class="hud-tag"><span><b>{p.drawing}</b> / ROBOT No.{p.robotNo}</span></p>
      <p class="season">{t(copy.season, lang)}</p>
      <h1 class="display">{t(copy.title, lang)}</h1>
      <p class="role">{t(copy.role, lang)}</p>
      <nav class="chapter-nav" aria-label={t(copy.navigation, lang)}>
        {p.chapters.map(c => <a href={`#${c.id}`}><span>{c.mark}</span>{t(c.title, lang)}</a>)}
      </nav>
    </div>
    <!-- The one lock box on the site: the record, tied to the arm end when 3D is live. -->
    <div class="lock" data-hud-reveal>
      <svg class="lock-leader" aria-hidden="true"><line x1="0" y1="0" x2="0" y2="0" data-lock-line /></svg>
      <span class="lock-reticle" aria-hidden="true"></span>
      <div class="lock-readout hud-frame">
        <span class="lock-label">{t(p.stats[0].label, lang)}<b>{p.stats[0].rank}</b></span>
        <span class="lock-value num"><span data-count-up>{p.stats[0].value}</span><small>{p.stats[0].unit}</small></span>
        <span class="lock-source">{t(p.statsSource, lang)}</span>
      </div>
    </div>
    <div class="wrap hero-foot" data-hud-reveal>
      <dl class="hud-readout">
        {p.titleBlock.slice(2).map(r => <div><dt>{t(r.label, lang)}</dt><dd class="text">{t(r.value, lang)}</dd></div>)}
      </dl>
      <details class="project-details">
        <summary>{t(copy.projectDetails, lang)}</summary>
        <dl class="hud-readout stats">{p.stats.slice(1).map(s => <div><dt>{t(s.label, lang)}</dt><dd>{s.value}<span class="unit">{s.rank}</span></dd></div>)}</dl>
      </details>
    </div>
  </header>

  <section class="wrap video-intro">
    <OfficialFilm
      lang={lang}
      label={sceneCopy.engineer.armFeature.label}
      credit={sceneCopy.engineer.armFeature.credit}
      href={sceneCopy.engineer.armFeature.href}
      file={sceneCopy.engineer.armFeature.file}
      poster={sceneCopy.engineer.armFeature.poster}
      alt={sceneCopy.engineer.armFeature.alt}
      soundOn={sceneCopy.engineer.armFeature.soundOn}
      soundOff={sceneCopy.engineer.armFeature.soundOff}
      play={sceneCopy.engineer.armFeature.play}
    />
  </section>

  <div class="wrap exhibit-sequence">
    {p.chapters.slice(0, 2).map(c => <EngineerChapter lang={lang} chapter={c}>
      {c.id === 'layout' && <EngineerMission lang={lang} concise />}
      {c.id === 'arm' && <ArmExplode lang={lang} />}
    </EngineerChapter>)}
    <div class="supporting-modules">
      {p.chapters.slice(2).map((c, i) => <EngineerChapter lang={lang} chapter={c} compact flip={i % 2 === 1} />)}
    </div>
  </div>

  <EasterEggs lang={lang} />

  <section class="wrap links" aria-label={t(sceneCopy.engineer.relatedLinks, lang)}>
    <ul>
      {p.links.map((l) => <li><a href={l.href} rel="noopener">{t(l.label, lang)}</a></li>)}
    </ul>
  </section>

  <NextSheet lang={lang} slug={hero.slug} drawing={hero.drawing} title={hero.title} />
  <Lightbox lang={lang} />
  </div>
</Base>

<style>
  /* First fold: the vehicle fills the stage, the title sits over its left side. */
  .showcase-hero { position: relative; display: grid; grid-template-rows: auto auto; padding-top: 5.5rem; overflow: hidden; }
  .hero-model { grid-row: 1; grid-column: 1; min-width: 0; padding-left: clamp(0px, 24vw, 380px); }
  .hero-model :global(.module-media), .hero-model :global(.media-view) { background: transparent; }
  .hero-model :global(.media-view) { height: clamp(520px, 74vh, 760px); }
  .hero-model :global(figcaption), .hero-model :global(.controls > span) { display: none; }
  .hero-model :global(.status) { left: auto; right: max(var(--gutter), calc((100vw - var(--maxw)) / 2 + var(--gutter))); }
  .hero-model :global(.controls) { justify-content: end; padding: 0 max(var(--gutter), calc((100vw - var(--maxw)) / 2 + var(--gutter))) 0 0; }
  .hero-heading { grid-row: 1; grid-column: 1; align-self: center; position: relative; z-index: 2; pointer-events: none; }
  .hero-heading > * { max-width: 30rem; }
  .hero-heading a { pointer-events: auto; }
  .hero-heading .hud-tag { justify-content: start; margin: 0 0 1.4rem; }
  .season { margin: 0 0 1rem; color: var(--amber); font: 500 1.15rem var(--f-latin); }
  h1 { margin: 0; font-size: clamp(3.6rem, 6.4vw, 6.4rem); line-height: 1.04; text-wrap: balance; text-shadow: 0 2px 24px var(--ground); }
  .role { margin: 1.4rem 0 0; font-size: var(--t-sm); color: var(--ink-2); }
  .chapter-nav { display: grid; grid-template-columns: repeat(2, max-content); gap: .1rem 1.6rem; margin-top: 2.2rem; padding-top: 1rem; border-top: 1px solid var(--rule); }
  .chapter-nav a { display: flex; gap: .55rem; align-items: baseline; text-decoration: none; color: var(--ink-3); font-size: var(--t-xs); padding: .3rem 0; }
  .chapter-nav a:hover { color: var(--ink); }
  .chapter-nav span { color: var(--amber); font-family: var(--f-mono); }
  /* Lock: reticle on the arm end, hairline leader, bracketed record readout. */
  .lock { position: absolute; inset: 0; z-index: 3; pointer-events: none; }
  .lock-leader { position: absolute; inset: 0; width: 100%; height: 100%; overflow: visible; }
  .lock-leader line { stroke: var(--amber); stroke-width: 1; opacity: .6; }
  .lock-reticle { position: absolute; left: var(--lock-x); top: var(--lock-y); width: 30px; height: 30px; transform: translate(-50%, -50%);
    --c: linear-gradient(var(--amber), var(--amber));
    background: var(--c) top left / 8px 1px, var(--c) top left / 1px 8px, var(--c) top right / 8px 1px, var(--c) top right / 1px 8px,
      var(--c) bottom left / 8px 1px, var(--c) bottom left / 1px 8px, var(--c) bottom right / 8px 1px, var(--c) bottom right / 1px 8px,
      radial-gradient(circle, var(--amber) 0 1.5px, transparent 2px) center / 100% 100%;
    background-repeat: no-repeat; }
  .showcase-hero:not([data-lock='on']) :is(.lock-leader, .lock-reticle) { display: none; }
  .lock-readout { position: absolute; right: max(var(--gutter), calc((100% - var(--maxw)) / 2 + var(--gutter))); top: 7.5rem; display: grid; gap: .35rem; padding: 1rem 1.2rem 1.05rem; background: rgba(7, 13, 23, .72); backdrop-filter: blur(6px); pointer-events: auto; }
  .lock-label { display: flex; justify-content: space-between; gap: 1.5rem; color: var(--ink-2); font-size: var(--t-xs); }
  .lock-label b { color: var(--amber); font: 500 .6875rem var(--f-mono); letter-spacing: .08em; }
  .lock-value { color: var(--amber); font: 600 3.6rem/1 var(--f-latin); font-variant-numeric: tabular-nums; letter-spacing: -.01em; }
  .lock-value small { margin-left: .35rem; font-size: 1.2rem; }
  .lock-source { max-width: 24ch; color: var(--ink-3); font-size: .6875rem; line-height: 1.5; }
  /* Foot: project facts as one ticked readout strip; results stay one click away. */
  .hero-foot { grid-row: 2; display: flex; flex-wrap: wrap; align-items: start; justify-content: space-between; gap: 0 2rem; }
  .hero-foot > .hud-readout { border-top: 0; padding-top: 10px; background: var(--ruler); background-position: left top; }
  .hero-foot dd.text { font: 500 var(--t-md)/1.4 var(--f-body); }
  .project-details { padding-top: 10px; }
  .project-details summary { cursor: pointer; color: var(--ink-2); font-size: var(--t-sm); padding: .85rem 0; }
  .project-details summary::marker { color: var(--amber); }
  .project-details summary:hover { color: var(--amber); }
  .project-details[open] { flex-basis: 100%; }
  .stats dd { font-size: 1.3rem; }
  .video-intro { padding-top: 4rem; }
  .video-intro :global(.official-film) { margin: 0; }
  .supporting-modules { display: grid; gap: 0; }
  .links { padding-top: 2rem; }
  .links ul { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: 1rem 2.5rem; }
  .links a { color: var(--amber); text-underline-offset: .25em; }
  @media(max-width: 1000px) {
  }
  @media(max-width: 900px) {
    /* Phone/tablet: stack title, model, record, facts; no leader. */
    .showcase-hero { display: flex; flex-direction: column; padding-top: 6.5rem; }
    .hero-heading { order: 1; }
    h1 { font-size: clamp(3.4rem, 11vw, 5rem); }
    .season { margin-bottom: .75rem; }
    .role { margin-top: 1rem; }
    .chapter-nav { grid-template-columns: repeat(2, minmax(0, 1fr)); margin-top: 1.25rem; }
    .chapter-nav a { display: grid; grid-template-columns: auto minmax(0, 1fr); }
    .hero-model { order: 2; padding-left: 0; margin-top: 1.5rem; }
    .hero-model :global(.media-view) { height: clamp(300px, 65vw, 480px); }
    .lock { order: 3; position: static; padding: 0 var(--gutter); }
    .lock-leader, .lock-reticle { display: none; }
    .lock-readout { position: relative; inset: auto; margin-top: 1rem; }
    .hero-foot { order: 4; margin-top: 1rem; }
    .video-intro { padding-top: 2.5rem; }
  }
</style>
