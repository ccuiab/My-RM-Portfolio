---
import Base from '../layouts/Base.astro';
import ProjectHeader from './ProjectHeader.astro';
import Chapter from './Chapter.astro';
import ArmUnfold from './ArmUnfold.astro';
import BilibiliVideo from './BilibiliVideo.astro';
import WristExplode from './WristExplode.astro';
import Lightbox from './Lightbox.astro';
import NextSheet from './NextSheet.astro';
import { engineer, hero, sceneCopy, pageCopy } from '../data/content';
import { t, type Lang } from '../data/i18n';
import lines from '../assets/gen/eng-reach-lines.webp';

interface Props { lang: Lang }
const { lang } = Astro.props;
const p = engineer;
---
<Base lang={lang} slug={p.slug} title={p.short} description={p.lede}>
  <section class="wrap video-opening">
    <BilibiliVideo
      lang={lang}
      label={sceneCopy.engineer.armFeature.label}
      credit={sceneCopy.engineer.armFeature.credit}
      href={sceneCopy.engineer.armFeature.href}
      embed={sceneCopy.engineer.armFeature.embed}
    />
  </section>

  <ProjectHeader
    lang={lang}
    drawing={p.drawing}
    robotNo={p.robotNo}
    title={p.title}
    lede={p.lede}
    cover={{ ...p.assembly, model: 'engineer.glb' }}
    lines={lines}
    titleBlock={p.titleBlock}
    stats={p.stats}
    statsSource={p.statsSource}
  />
  {p.chapters.map((c) => (
    <Chapter lang={lang} chapter={c} layout={c.id === 'layout' || c.id === 'arm' ? 'expanded' : 'standard'}>
      {c.scene === 'arm-unfold' && <ArmUnfold lang={lang} slot="wide" />}
      {c.id === 'arm' && <WristExplode lang={lang} slot="wide" />}
    </Chapter>
  ))}

  <section class="wrap links" aria-label={t(sceneCopy.engineer.relatedLinks, lang)}>
    <ul>
      {p.links.map((l) => <li><a href={l.href} rel="noopener">{t(l.label, lang)}</a></li>)}
    </ul>
  </section>

  <NextSheet lang={lang} slug={hero.slug} drawing={hero.drawing} title={hero.title} />
  <Lightbox lang={lang} />
</Base>

<style>
  .video-opening { padding-top: clamp(7rem, 9vw, 8.5rem); }
  .video-opening :global(.bilibili-video) { margin: 0; padding-top: 0; border-top: 0; }
  .video-opening + :global(.ph) { padding-top: clamp(3rem, 5vw, 5rem); }
  .links { padding-top: 5rem; }
  .links ul { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: 1rem 2.5rem; }
  .links a { color: var(--amber); text-underline-offset: 4px; }
</style>
