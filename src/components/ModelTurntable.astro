---
import ModuleMedia from './ModuleMedia.astro';
import type { ImageMetadata } from 'astro';
import { t, type Lang, type T } from '../data/i18n';
interface Props { lang: Lang; file: string; still: ImageMetadata; alt: T; caption: T; scan?: boolean }
const { lang, file, still, alt, caption } = Astro.props;
---
<div class="assembly-media">
  <ModuleMedia lang={lang} pic={{src: still, model: file, alt, light: true}} />
  <p>{t(caption, lang)}</p>
</div>
<style>.assembly-media { display: grid; gap: .65rem; } p { color: var(--ink-3); font-size: var(--t-xs); }</style>
