---
// Static robot model that the visitor can turn by dragging; scroll scans it from outline to solid.
// Falls back to the given still if WebGL or the model is unavailable.
import { existsSync } from 'node:fs';
import { join } from 'node:path';
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { t, type Lang, type T } from '../data/i18n';
import { sceneCopy } from '../data/content';
import SceneControls from './SceneControls.astro';

interface Props { lang: Lang; file: string; still: ImageMetadata; alt: T; caption: T; scan?: boolean }
const { lang, file, still, alt, caption, scan = true } = Astro.props;
const hasModel = existsSync(join(process.cwd(), 'public', 'models', file));
---
<figure class="tt" data-tt data-file={hasModel ? file : ''} data-scan={scan ? '1' : '0'}>
  <div class="view panel">
    <div class="still"><Image src={still} alt={t(alt, lang)} widths={[720, 1100]} sizes="(max-width: 900px) 100vw, 70vw" /></div>
    <canvas class="three" tabindex="-1" role="img" aria-label={t(sceneCopy.interaction.hint, lang)}></canvas>
    <span class="hint">{t(sceneCopy.modelTurntable.hint, lang)}</span>
  </div>
  {hasModel && <button type="button" class="load-model" data-load-model data-loading={t(sceneCopy.module.loading, lang)} data-failed={t(sceneCopy.module.failed, lang)}>{t(sceneCopy.module.model, lang)}</button>}
  <SceneControls lang={lang} />
  <figcaption>{t(caption, lang)}</figcaption>
</figure>

<script>
  import { ScrollTrigger, reducedMotion } from '../scripts/smooth';

  document.querySelectorAll<HTMLElement>('[data-tt]').forEach((root) => {
    const file = root.dataset.file;
    if (!file) return;
    const canvas = root.querySelector<HTMLCanvasElement>('canvas')!;
    const loadButton = root.querySelector<HTMLButtonElement>('[data-load-model]')!;
    let started = false;

    const start = () => {
      if (started) return;
      started = true;
      loadButton.disabled = true;
      loadButton.textContent = loadButton.dataset.loading!;
      return Promise.all([import('../scripts/scan-scene'), import('three')]).then(async ([{ loadScanStage }, THREE]) => {
      const stage = await loadScanStage(canvas, import.meta.env.BASE_URL, file, { axis: new THREE.Vector3(0, 0, 1), range: [0.7, -0.7], solidOnly: root.dataset.scan === '0' });
      const box = new THREE.Box3().setFromObject(stage.model);
      const sphere = box.getBoundingSphere(new THREE.Sphere());
      stage.model.position.sub(sphere.center);
      sphere.center.set(0, 0, 0);
      stage.frame(sphere, file === 'engineer.glb' ? new THREE.Vector3(-1.25, 0.62, 1.8) : new THREE.Vector3(1, 0.5, 1.1));

      const scanEnabled = root.dataset.scan !== '0';
      let yaw = scanEnabled ? -30 : 0, scan = scanEnabled ? 0 : 1, interacting = false;
      const draw = () => {
        stage.turntable.rotation.y = THREE.MathUtils.degToRad(yaw);
        stage.setScan(scan);
        stage.render();
      };
      stage.onResize(draw);
      root.classList.add('has-3d');
      loadButton.hidden = true;
      draw();

      stage.enableInteraction(draw);
      canvas.addEventListener('pointerdown', () => { interacting = true; scan = 1; draw(); });
      root.querySelector('[data-reset-view]')!.addEventListener('click', () => stage.resetView());

      if (!reducedMotion && scanEnabled) {
        ScrollTrigger.create({
          trigger: root,
          start: 'top 80%',
          end: 'center 45%',
          scrub: 0.5,
          onUpdate: (st) => { if (!interacting) { scan = st.progress; yaw = -30 + st.progress * 40; draw(); } },
        });
      }
    }).catch((err) => {
      started = false;
      loadButton.disabled = false;
      loadButton.textContent = loadButton.dataset.failed!;
      console.warn('model unavailable, keeping the still', err);
    });
    };
    loadButton.addEventListener('click', start);
    if (reducedMotion || !window.matchMedia('(min-width: 900px)').matches) return;

    const io = new IntersectionObserver(([en]) => {
      if (en.isIntersecting) { io.disconnect(); start(); }
    }, { rootMargin: '700px 0px' });
    io.observe(root);
  });
</script>

<style>
  .tt { margin: 0; display: grid; gap: 0.6rem; }
  .load-model { justify-self: start; padding: .6rem 1rem; border: 1px solid var(--amber); color: var(--amber); background: var(--panel); font: inherit; cursor: pointer; }
  .load-model[hidden] { display: none; }
  .view {
    position: relative;
    height: min(62vh, 56vw);
    min-height: 320px;
    background: var(--ground);
  }
  .still {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    background: var(--plate);
    transition: opacity 0.5s;
  }
  .still :global(img) { max-height: 92%; width: auto; mix-blend-mode: multiply; }
  .three { position: absolute; inset: 0; width: 100%; height: 100%; opacity: 0; transition: opacity 0.6s; cursor: grab; touch-action: none; pointer-events: none; }
  .has-3d .three { pointer-events: auto; }
  .three:active { cursor: grabbing; }
  .hint { position: absolute; left: 1.2rem; bottom: 1rem; font-size: var(--t-xs); color: var(--ink-3); opacity: 0; }
  .has-3d .still { opacity: 0; }
  .has-3d .three, .has-3d .hint { opacity: 1; }
  figcaption { font-size: var(--t-xs); color: var(--ink-3); }
</style>
