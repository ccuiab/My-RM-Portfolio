---
// Home hero: the robot is drawn as amber edge lines, then a scan bar reveals the photo.
// HUD readouts lock in as the scan passes them.
import { Image } from 'astro:assets';
import { person } from '../data/content';
import { t, href, type Lang } from '../data/i18n';
import lines from '../assets/gen/eng-reach-lines.webp';

interface Props { lang: Lang }
const { lang } = Astro.props;
---
<section class="hero" data-hero aria-labelledby="hero-name">
  <div class="stage" aria-hidden="true">
    <Image class="photo" src={person.heroPic.src} alt="" widths={[960, 1920]} sizes="100vw" loading="eager" fetchpriority="high" />
    <Image class="lines" src={lines} alt="" widths={[960, 1920]} sizes="100vw" loading="eager" />
    <div class="scan"></div>
    <div class="vignette"></div>
  </div>

  <div class="wrap copy">
    <p class="role latin">{person.role}</p>
    <h1 id="hero-name" class="name">
      <span class="name-cjk">{person.nameZh}</span>
      <span class="name-latin latin">{person.nameEn}</span>
    </h1>
    <p class="tagline">{t(person.tagline, lang)}</p>
    <p class="subline">{t(person.subline, lang)}</p>

    <dl class="readouts">
      {person.readouts.map((r, i) => (
        <div class="readout" style={`--i:${i}`}>
          <dt>{t(r.label, lang)}</dt>
          <dd><span class="num val">{r.value}</span><span class="unit num">{r.unit}</span></dd>
        </div>
      ))}
    </dl>

    <a class="cta" href={href(lang, 'engineer')}>
      <span class="badge latin">{person.badge}</span>
      <span class="cta-text">{lang === 'zh' ? '看工程机器人 2025' : 'See the 2025 Engineer robot'}</span>
    </a>
  </div>
</section>

<script>
  import { gsap, reducedMotion } from '../scripts/smooth';

  const root = document.querySelector<HTMLElement>('[data-hero]');
  if (root) {
    const reveal = (p: number) => root.style.setProperty('--reveal', `${p}%`);
    if (reducedMotion) {
      reveal(100);
      root.classList.add('locked');
    } else {
      const state = { p: 0 };
      const tl = gsap.timeline({ delay: 0.25 });
      tl.from(root.querySelectorAll('.lines'), { opacity: 0, duration: 0.6, ease: 'power1.out' })
        .to(state, {
          p: 100,
          duration: 2.1,
          ease: 'power2.inOut',
          onUpdate: () => reveal(state.p),
        })
        .add(() => root.classList.add('locked'), '-=0.9');
      // counters roll while the scan passes
      root.querySelectorAll<HTMLElement>('.val').forEach((el, i) => {
        const end = parseFloat(el.textContent || '0');
        const decimals = (el.textContent || '').includes('.') ? 1 : 0;
        const c = { v: 0 };
        tl.to(c, {
          v: end,
          duration: 1.1,
          ease: 'power3.out',
          onUpdate: () => (el.textContent = c.v.toFixed(decimals)),
        }, 1.0 + i * 0.18);
      });
    }
  }
</script>

<style>
  .hero {
    --reveal: 0%;
    position: relative;
    min-height: 100svh;
    display: flex;
    align-items: flex-end;
    padding: 7rem 0 4.5rem;
    overflow: hidden;
    isolation: isolate;
  }
  .stage {
    position: absolute;
    inset: 0;
    z-index: -1;
  }
  .stage :global(img) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    /* the robot sits right of centre; keep it clear of the copy column */
    object-position: 88% 50%;
  }
  .photo {
    clip-path: inset(0 calc(100% - var(--reveal)) 0 0);
    filter: saturate(0.85) contrast(1.05);
  }
  .lines {
    clip-path: inset(0 0 0 var(--reveal));
    opacity: 0.95;
  }
  .scan {
    position: absolute;
    top: 0;
    bottom: 0;
    left: var(--reveal);
    width: 2px;
    background: var(--amber);
    box-shadow: 0 0 24px 4px rgba(242, 181, 58, 0.55);
    opacity: 0;
  }
  .hero:not(.locked) .scan { opacity: 1; }
  .vignette {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(90deg, rgba(7, 13, 23, 0.96) 0%, rgba(7, 13, 23, 0.82) 30%, rgba(7, 13, 23, 0.15) 58%, rgba(7, 13, 23, 0.25) 100%),
      linear-gradient(0deg, var(--ground) 0%, transparent 30%),
      linear-gradient(180deg, rgba(7, 13, 23, 0.7) 0%, transparent 18%);
  }

  .copy {
    position: relative;
    display: grid;
    gap: 1.1rem;
  }
  .role {
    font-size: var(--t-sm);
    letter-spacing: 0.12em;
    color: var(--amber);
  }
  .name {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }
  .name-cjk {
    font-family: var(--f-cjk);
    font-size: clamp(4.5rem, 12vw, 10rem);
    line-height: 0.92;
    letter-spacing: 0.02em;
  }
  .name-latin {
    font-size: var(--t-xl);
    color: var(--ink-2);
    letter-spacing: 0.06em;
  }
  .tagline {
    font-family: var(--f-cjk);
    font-size: var(--t-2xl);
    line-height: 1.2;
    margin-top: 0.6rem;
  }
  :lang(en) .tagline { font-family: var(--f-latin); font-weight: 700; letter-spacing: -0.01em; }
  .subline {
    color: var(--ink-2);
    font-size: var(--t-md);
  }

  .readouts {
    display: flex;
    flex-wrap: wrap;
    gap: 0;
    margin: 1.5rem 0 0;
    border-top: 1px solid var(--rule);
    max-width: 760px;
  }
  .readout {
    flex: 1 1 180px;
    padding: 1rem 1.4rem 0.2rem 0;
    margin-right: 1.4rem;
    border-right: 1px solid var(--rule);
  }
  .readout:last-child { border-right: 0; }
  .readout dt {
    font-size: var(--t-xs);
    color: var(--ink-3);
  }
  .readout dd {
    margin: 0.25rem 0 0;
    display: flex;
    align-items: baseline;
    gap: 0.35rem;
  }
  .readout .val {
    font-size: var(--t-3xl);
    line-height: 1;
    color: var(--ink);
    transition: color 0.3s;
  }
  .hero.locked .readout .val { color: var(--amber); }
  .readout .unit { font-size: var(--t-md); color: var(--ink-2); }

  .cta {
    justify-self: start;
    display: inline-flex;
    flex-direction: column;
    gap: 0.15rem;
    margin-top: 1.4rem;
    padding: 0.8rem 1.4rem 0.9rem;
    text-decoration: none;
    background: var(--amber);
    color: var(--ground);
    clip-path: polygon(10px 0, 100% 0, 100% calc(100% - 10px), calc(100% - 10px) 100%, 0 100%, 0 10px);
    transition: transform 0.2s;
  }
  .cta:hover { transform: translateY(-2px); }
  .badge { font-size: var(--t-xs); letter-spacing: 0.08em; opacity: 0.75; }
  .cta-text { font-weight: 600; }

  @media (max-width: 760px) {
    .readout { flex-basis: 40%; }
    .vignette {
      background: linear-gradient(0deg, var(--ground) 8%, rgba(7, 13, 23, 0.75) 55%, rgba(7, 13, 23, 0.35) 100%);
    }
  }
</style>
