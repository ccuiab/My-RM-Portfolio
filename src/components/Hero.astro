---
// One photographic introduction for every screen; technical scenes live in the projects.
import { Image } from 'astro:assets';
import { person, pageCopy } from '../data/content';
import { t, href, type Lang } from '../data/i18n';

interface Props { lang: Lang }
const { lang } = Astro.props;
---
<section class="hero" data-hero aria-labelledby="hero-name">
  <div class="stage" aria-hidden="true">
    <Image class="photo" src={person.heroPic.src} alt="" widths={[960, 1920]} sizes="100vw" loading="eager" fetchpriority="high" />
  </div>
  <div class="wrap">
    <div class="copy">
      <p class="role latin">{person.role}</p>
      <h1 id="hero-name" class="name">
        <span class="name-cjk">{person.nameZh}</span>
        <span class="name-latin latin">{person.nameEn}</span>
      </h1>
      <p class="tagline">{t(person.tagline, lang)}</p>
      <p class="subline">{t(person.subline, lang)}</p>
      <div class="actions">
        <a class="cta" href={`${href(lang)}#projects`}>{t(pageCopy.homeProjects, lang)}</a>
        <a class="secondary" href={href(lang, 'engineer')}>{t(pageCopy.homeEngineer, lang)}</a>
      </div>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    min-height: min(860px, 88svh);
    display: flex;
    align-items: center;
    padding: 8rem 0 5rem;
    overflow: hidden;
    isolation: isolate;
    background: var(--ground);
  }
  .stage { position: absolute; inset: 0; z-index: -1; }
  .stage :global(img) {
    width: 100%; height: 100%; object-fit: cover;
    object-position: 86% 45%;
    filter: saturate(0.85) contrast(1.05);
  }
  .stage::after {
    content: ''; position: absolute; inset: 0;
    background:
      linear-gradient(90deg, rgba(7,13,23,.98), rgba(7,13,23,.78) 30%, rgba(7,13,23,.12) 70%),
      linear-gradient(0deg, var(--ground), transparent 27%),
      linear-gradient(180deg, rgba(7,13,23,.45), transparent 25%);
  }
  .copy { position: relative; display: grid; gap: 1.15rem; max-width: 35rem; }
  .role { font-size: var(--t-sm); letter-spacing: .08em; color: var(--amber); }
  .name { display: flex; flex-direction: column; gap: .6rem; }
  .name-cjk { font-family: var(--f-cjk); font-size: clamp(4.5rem, 8.5vw, 9rem); line-height: .95; letter-spacing: .02em; }
  .name-latin { font-size: var(--t-xl); color: var(--ink-2); letter-spacing: .06em; }
  .tagline { font-family: var(--f-cjk); font-size: clamp(1.9rem, 2.6vw, 2.8rem); line-height: 1.3; margin-top: .75rem; }
  :lang(en) .tagline { font-family: var(--f-latin); font-weight: 700; letter-spacing: -.01em; }
  .subline { color: var(--ink-2); font-size: var(--t-md); max-width: 31rem; }
  .actions { display: flex; align-items: center; flex-wrap: wrap; gap: 1rem 1.5rem; margin-top: 1.3rem; }
  .cta { display: inline-flex; padding: .85rem 1.5rem; background: var(--amber); color: var(--ground); font-weight: 600; text-decoration: none; clip-path: polygon(10px 0,100% 0,100% calc(100% - 10px),calc(100% - 10px) 100%,0 100%,0 10px); }
  .cta:hover { background: var(--ink); }
  .secondary { color: var(--ink); font-size: var(--t-sm); text-underline-offset: 5px; text-decoration-thickness: 1px; }
  .secondary:hover { color: var(--amber); }
  @media (max-width: 760px) {
    .hero { min-height: 82svh; align-items: end; padding: 7rem 0 4rem; }
    .copy { gap: .9rem; }
    .name-cjk { font-size: clamp(4.2rem, 17vw, 6rem); }
    .name-latin { font-size: 1.5rem; }
    .role { font-size: .75rem; letter-spacing: .035em; }
    .tagline { font-size: 1.9rem; }
    .stage :global(img) { object-position: 78% 25%; }
    .stage::after { background: linear-gradient(0deg,var(--ground),rgba(7,13,23,.82) 35%,rgba(7,13,23,.25) 100%); }
    .actions { margin-top: .8rem; gap: .9rem 1.2rem; }
  }
</style>
