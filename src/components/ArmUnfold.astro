---
// User-controlled CAD pose demonstration; the sketch remains a loading fallback.
import { existsSync } from 'node:fs';
import { join } from 'node:path';
import { sceneCopy } from '../data/content';
import { t, type Lang } from '../data/i18n';


interface Props { lang: Lang }
const { lang } = Astro.props;
// builds run from the project root; import.meta.url points into the bundle, not src/
const hasModel = existsSync(join(process.cwd(), 'public', 'models', 'arm.glb'));
const L = sceneCopy.armUnfold;
---
<div class="unfold" data-unfold data-model={hasModel ? '1' : ''} data-labels={`${t(L.folded, lang)}|${t(L.extended, lang)}`}>
  <div class="pin">
    <div class="view panel">
      <svg class="sketch" viewBox="-200 -880 1200 820" role="img" aria-label={t(L.sketchAlt, lang)}>
        <defs>
          <pattern id="arm-grid" width="40" height="40" patternUnits="userSpaceOnUse">
            <path d="M40 0H0V40" fill="none" stroke="var(--rule)" stroke-width="1" />
          </pattern>
        </defs>
        <rect x="-200" y="-880" width="1200" height="820" fill="url(#arm-grid)" />
        <g class="sk">
          <line x1="-200" y1="-100" x2="1000" y2="-100" stroke="var(--ink-3)" stroke-width="2" />
          <line class="l2" stroke="var(--ink)" stroke-width="30" stroke-linecap="round" />
          <line class="l34" stroke="var(--ink-2)" stroke-width="22" stroke-linecap="round" />
          <circle class="j-sh" r="20" fill="var(--ground)" stroke="var(--amber)" stroke-width="4" />
          <circle class="j-el" r="16" fill="var(--ground)" stroke="var(--amber)" stroke-width="4" />
          <circle class="j-wr" r="14" fill="var(--amber)" />
        </g>
      </svg>
      <canvas class="three" tabindex="-1" role="img" aria-label={t(sceneCopy.interaction.hint, lang)}></canvas>
      <svg class="marks" aria-hidden="true">
        <line class="m-l2" /><line class="m-l34" />
        <circle class="m-sh" r="5" /><circle class="m-el" r="5" /><circle class="m-wr" r="5" />
        <text class="m-t2">L2 380</text><text class="m-t34">L3+L4 420</text>
      </svg>
      <span class="state latin" data-state>{t(L.folded, lang)}</span>
    </div>

    <div class="arm-controls">
      <label class="pose-control"><span>{t(sceneCopy.interaction.arm, lang)}</span><input data-scene-progress type="range" min="0" max="100" value="0" step="0.1" /><output data-progress>0%</output></label>
      <button type="button" data-reset-view>{t(sceneCopy.interaction.reset, lang)}</button>
      <span class="drag-hint">{t(sceneCopy.interaction.hint, lang)}</span>
    </div>
    <div class="metrics">
    <figure class="envelopes" aria-describedby="envelope-guide">
      <div><span class="envelope-label">{t(L.foldedEnvelope, lang)}</span><p class="num">590 × 590 × 540 <span>mm</span></p></div>
      <div><span class="envelope-label">{t(L.expandedEnvelope, lang)}</span><p class="num">1400 × 1400 × 1200 <span>mm</span></p></div>
      <figcaption id="envelope-guide">{t(L.envelopeGuide, lang)}</figcaption>
    </figure>

    <dl class="readout">
      <div><dt>{t(L.reach, lang)}</dt><dd><span class="num" data-r>0</span><span class="num u">mm</span></dd></div>
      <div><dt>{t(L.height, lang)}</dt><dd><span class="num" data-h>0</span><span class="num u">mm</span></dd></div>
    </dl>
    </div>
    <p class="note">{t(L.note, lang)}</p>
    <p class="static-note">{t(L.staticNote, lang)}</p>
  </div>
</div>

<script>
  import { gsap } from '../scripts/smooth';

  type Pt = { x: number; y: number };
  type Frame = { shoulder: Pt; elbow: Pt; wrist: Pt; reachMm: number; heightMm: number };

  document.querySelectorAll<HTMLElement>('[data-unfold]').forEach((root) => {
    const $ = <E extends Element>(s: string) => root.querySelector<E>(s)!;
    const [folded, extended] = (root.dataset.labels || '|').split('|');
    const hOut = $<HTMLElement>('[data-h]'), rOut = $<HTMLElement>('[data-r]'), stOut = $<HTMLElement>('[data-state]');
    const attr = (el: Element, a: Record<string, number>) => { for (const k in a) el.setAttribute(k, a[k].toFixed(1)); };
    const ease = gsap.parseEase('power2.inOut');

    const readouts = (f: Frame, p: number) => {
      rOut.textContent = `${Math.round(f.reachMm)}`;
      hOut.textContent = `${Math.round(f.heightMm)}`;
      stOut.textContent = p > 0.97 ? extended : p < 0.03 ? folded : `${Math.round(p * 100)}%`;
      root.classList.toggle('extended', p > 0.97);
    };

    /* ---- 2D sketch (fallback and pre-load state) ---- */
    const L2 = 380, L34 = 420, SH = { x: 0, y: -420 };
    const rad = (d: number) => (d * Math.PI) / 180;
    const sketch = (p: number) => {
      const e_ = ease(p);
      const sh = gsap.utils.interpolate(112, 32, e_);
      const a2 = sh + gsap.utils.interpolate(-150, -20, e_);
      const el = { x: SH.x + L2 * Math.cos(rad(sh)), y: SH.y - L2 * Math.sin(rad(sh)) };
      const wr = { x: el.x + L34 * Math.cos(rad(a2)), y: el.y - L34 * Math.sin(rad(a2)) };
      attr($('.l2'), { x1: SH.x, y1: SH.y, x2: el.x, y2: el.y });
      attr($('.l34'), { x1: el.x, y1: el.y, x2: wr.x, y2: wr.y });
      attr($('.j-sh'), { cx: SH.x, cy: SH.y });
      attr($('.j-el'), { cx: el.x, cy: el.y });
      attr($('.j-wr'), { cx: wr.x, cy: wr.y });
      readouts({ shoulder: SH, elbow: el, wrist: wr, reachMm: wr.x - SH.x, heightMm: SH.y - wr.y }, p);
    };

    // Pose changes only through this control. Camera drag never changes the joint pose.
    let draw = sketch;
    let progress = 0;
    const slider = $<HTMLInputElement>('[data-scene-progress]');
    const output = $<HTMLOutputElement>('[data-progress]');
    slider.addEventListener('input', () => {
      progress = Number(slider.value) / 100;
      output.value = `${Math.round(progress * 100)}%`;
      draw(progress);
    });
    draw(progress);
    if (!root.dataset.model) { root.classList.add('fallback'); return; }

    const start = () => import('../scripts/arm-scene').then(async ({ loadArmScene }) => {
      const arm = await loadArmScene($<HTMLCanvasElement>('canvas.three'), import.meta.env.BASE_URL);
      const lerp = gsap.utils.interpolate;
      draw = (p: number) => {
        const e_ = ease(p);
        // CAD export pose is the folded pose; the end pose is a forward reach, wrist near level
        arm.setPose({ J2: lerp(0, 110, e_), J3: lerp(0, -130, e_), J5: lerp(0, 40, e_) });
        const f = arm.render();
        attr($('.m-l2'), { x1: f.shoulder.x, y1: f.shoulder.y, x2: f.elbow.x, y2: f.elbow.y });
        attr($('.m-l34'), { x1: f.elbow.x, y1: f.elbow.y, x2: f.wrist.x, y2: f.wrist.y });
        attr($('.m-sh'), { cx: f.shoulder.x, cy: f.shoulder.y });
        attr($('.m-el'), { cx: f.elbow.x, cy: f.elbow.y });
        attr($('.m-wr'), { cx: f.wrist.x, cy: f.wrist.y });
        attr($('.m-t2'), { x: (f.shoulder.x + f.elbow.x) / 2 + 14, y: (f.shoulder.y + f.elbow.y) / 2 - 8 });
        attr($('.m-t34'), { x: (f.elbow.x + f.wrist.x) / 2 + 8, y: (f.elbow.y + f.wrist.y) / 2 - 14 });
        readouts(f, p);
      };
      // Resize and camera interaction redraw the current pose without changing it.
      arm.onResize(() => draw(progress));
      arm.onInteraction(() => draw(progress));
      $('[data-reset-view]').addEventListener('click', () => arm.resetView());
      root.classList.add('has-3d');
      draw(progress);
    }).catch((err) => { root.classList.add('fallback'); console.warn('arm scene unavailable, keeping the sketch', err); });

    // load when the section gets near, so the rest of the page stays light
    const io = new IntersectionObserver(([en]) => {
      if (en.isIntersecting) { io.disconnect(); start(); }
    }, { rootMargin: '800px 0px' });
    io.observe(root);
  });
</script>

<style>
  .unfold { margin-top: .5rem; border: 1px solid var(--rule); background: var(--ground); }
  .pin { display: grid; }
  .view { position: relative; height: clamp(320px, 30vw, 420px); border: 0; }
  .view > svg, .view > canvas { position: absolute; inset: 0; width: 100%; height: 100%; }
  .three, .marks { opacity: 0; }
  .three { cursor: grab; touch-action: none; pointer-events: none; }
  .has-3d .three { pointer-events: auto; }
  .three:active { cursor: grabbing; }
  .has-3d .three, .has-3d .marks { opacity: 1; }
  .has-3d .sketch { opacity: 0; }
  .marks, .state { pointer-events: none; }
  .marks line { stroke: var(--amber); stroke-width: 1; stroke-dasharray: 3 5; opacity: .5; }
  .marks circle { fill: none; stroke: var(--amber); stroke-width: 1.5; }
  .marks text { font-family: var(--f-mono); font-size: 11px; fill: var(--amber); paint-order: stroke; stroke: var(--ground); stroke-width: 4px; }
  .state { position: absolute; top: 1rem; left: 1.2rem; font-size: var(--t-sm); color: var(--ink-2); border-left: 3px solid var(--amber); padding-left: .65rem; }
  .arm-controls { display: flex; align-items: center; flex-wrap: wrap; gap: .7rem 1.2rem; padding: 1rem 1.2rem; border-top: 1px solid var(--rule); font-size: var(--t-xs); }
  .pose-control { display: flex; align-items: center; gap: .8rem; flex: 1; }
  .pose-control span { white-space: nowrap; }
  .pose-control input { min-width: 90px; flex: 1; accent-color: var(--amber); cursor: pointer; }
  output { min-width: 4ch; font-family: var(--f-mono); color: var(--amber); }
  button { color: var(--ink); background: transparent; border: 1px solid var(--rule); padding: .45rem .7rem; cursor: pointer; font: inherit; }
  button:hover { color: var(--amber); border-color: var(--amber); }
  button:focus-visible, input:focus-visible, .three:focus-visible { outline: 2px solid var(--amber); outline-offset: 3px; }
  .drag-hint { color: var(--ink-3); }
  .metrics { display: grid; grid-template-columns: 1fr; gap: 1.5rem; border-top: 1px solid var(--rule); padding: 1rem 1.2rem; }
  .envelopes { margin: 0; display: grid; grid-template-columns: 1fr 1fr; gap: .5rem 1rem; }
  .envelope-label, .readout dt { font-size: var(--t-xs); color: var(--ink-3); }
  .envelopes p { font-size: .85rem; margin: .3rem 0; }
  .envelopes p span { font-size: var(--t-xs); color: var(--ink-3); }
  .envelopes figcaption { grid-column: 1 / -1; font-size: var(--t-xs); color: var(--ink-3); line-height: 1.5; }
  .readout { display: grid; grid-template-columns: 1fr 1fr; margin: 0; gap: 1rem; }
  .readout dd { margin: .3rem 0 0; font-size: var(--t-lg); }
  .readout [data-r], .readout [data-h] { color: var(--amber); min-width: 4ch; display: inline-block; }
  .readout .u { font-size: var(--t-xs); color: var(--ink-3); }
  .note, .static-note { padding: 0 1.2rem; font-size: var(--t-xs); color: var(--ink-3); line-height: 1.6; }
  .static-note { display: none; }
  .fallback .static-note { display: block; }
  .unfold:not(.has-3d) .note, .unfold:not(.has-3d) .readout { visibility: hidden; }
  @media (max-width: 760px) { .metrics { grid-template-columns: 1fr; gap: 1rem; } .drag-hint { flex-basis: 100%; } .view { height: 380px; } }
</style>
