---
// Skills as a bill of materials: item, specification, where it was used.
import { bom, pageCopy } from '../data/content';
import { t, type Lang } from '../data/i18n';

interface Props { lang: Lang }
const { lang } = Astro.props;
const head = pageCopy.bomHead;
---
<section class="bom wrap" aria-labelledby="bom-title">
  <h2 id="bom-title" class="display heading">{t(pageCopy.bomTitle, lang)}</h2>
  <div class="scroll">
    <table>
      <thead>
        <tr><th scope="col">{t(head.no, lang)}</th><th scope="col">{t(head.item, lang)}</th><th scope="col">{t(head.spec, lang)}</th><th scope="col">{t(head.used, lang)}</th></tr>
      </thead>
      <tbody>
        {bom.map((row) => (
          <tr>
            <td class="num no">{row.no}</td>
            <th scope="row" class="item">{t(row.item, lang)}</th>
            <td class="spec" data-label={t(head.spec, lang)}>{t(row.spec, lang)}</td>
            <td class="used" data-label={t(head.used, lang)}>{t(row.used, lang)}</td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>
</section>

<style>
  .bom { padding-top: var(--section-space); }
  .heading { font-size: clamp(2.2rem, 4vw, 3.15rem); margin-bottom: var(--heading-space); }
  .scroll { overflow-x: auto; }
  table {
    width: 100%;
    min-width: 720px;
    border-collapse: collapse;
    font-size: var(--t-sm);
  }
  thead th {
    text-align: left;
    font-weight: 400;
    color: var(--ink-3);
    font-size: var(--t-xs);
    padding: 0 1rem 0.7rem 0;
    border-bottom: 1px solid var(--amber);
  }
  td, tbody th {
    text-align: left;
    vertical-align: top;
    padding: .85rem 1rem .85rem 0;
    border-bottom: 1px solid var(--rule);
  }
  .no { color: var(--amber); width: 5rem; }
  .item { font-weight: 600; width: 11rem; }
  .spec { color: var(--ink-2); }
  .used { color: var(--ink-3); width: 13rem; }
  tbody tr:hover td, tbody tr:hover th { background: rgba(242, 181, 58, 0.04); }
  @media (max-width: 720px) {
    .scroll { overflow: visible; }
    table, tbody { display: block; min-width: 0; }
    thead { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); }
    tbody { border-top: 1px solid var(--amber); }
    tbody tr { display: grid; grid-template-columns: 3.5rem minmax(0, 1fr); gap: .5rem 1rem; padding: 1rem 0; border-bottom: 1px solid var(--rule); }
    td, tbody th { width: auto; min-width: 0; padding: 0; border: 0; }
    .no, .item, .used { width: auto; }
    .spec, .used { grid-column: 2; }
    .spec::before, .used::before { content: attr(data-label); display: block; margin-bottom: .2rem; color: var(--ink-3); font-size: var(--t-xs); }
  }
</style>
