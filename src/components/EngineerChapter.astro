---
import { Image } from 'astro:assets';
import ModuleMedia from './ModuleMedia.astro';
import { engineerShowcase as copy, sceneCopy, type Chapter } from '../data/content';
import { t, ui, type Lang } from '../data/i18n';
interface Props { lang: Lang; chapter: Chapter; compact?: boolean }
const { lang, chapter: c, compact = false } = Astro.props;
const sentence = copy.chapters[c.id as keyof typeof copy.chapters];
---
<section class:list={['exhibit', { compact }]} id={c.id} aria-labelledby={`${c.id}-title`}>
  <header class="exhibit-heading">
    <div class="heading-line">
      <span class="mark" aria-hidden="true">{c.mark}</span>
      <h2 class="display" id={`${c.id}-title`}>{t(c.title, lang)}</h2>
    </div>
    <p>{t(sentence, lang)}</p>
  </header>
  <div class="exhibit-media">
    <slot />
    {c.pics?.map(pic => pic.model ? <ModuleMedia pic={pic} lang={lang} concise /> : (
      <button class:list={['image', { light: pic.light || pic.cutout }]} type="button" data-zoom={pic.src.src} data-alt={t(pic.alt, lang)} aria-label={`${t(ui.enlarge, lang)}: ${t(pic.alt, lang)}`}>
        <Image src={pic.src} alt={t(pic.alt, lang)} widths={[480, 900, 1400]} sizes="(max-width: 1000px) 100vw, 50vw" />
      </button>
    ))}
  </div>
  <div class="exhibit-footer">
    {c.specs && <dl class="specs">{c.specs.map(s => <div>
      <dt>{t(s.label, lang)}{s.note && <span> · {t(s.note, lang)}</span>}</dt>
      <dd><span class="num">{s.value}</span><span class="unit">{s.unit}</span></dd>
    </div>)}</dl>}
    <details class="design-details">
      <summary>{t(copy.designDetails, lang)}</summary>
      <div class="detail-body">
        {c.lede && <p>{t(c.lede, lang)}</p>}
        {c.bullets && <ul>{c.bullets.map(b => <li>{t(b, lang)}</li>)}</ul>}
        {c.id === 'chassis' && <p>{t(sceneCopy.swerve.sensorNote, lang)}</p>}
      </div>
    </details>
  </div>
</section>
<style>
  .exhibit { min-width: 0; padding-top: clamp(4rem, 8vw, 7rem); scroll-margin-top: 6rem; }
  .exhibit-heading { display: flex; align-items: end; justify-content: space-between; gap: 1.5rem; margin-bottom: 1.6rem; }
  .heading-line { display: flex; align-items: baseline; gap: 1rem; }
  .mark { font: 500 1.25rem var(--f-latin); color: var(--amber); }
  h2 { margin: 0; font-size: clamp(1.8rem, 3.1vw, 3rem); text-wrap: balance; }
  .exhibit-heading p { margin: 0; max-width: 32ch; color: var(--ink-2); font-size: var(--t-sm); }
  .exhibit-media { min-width: 0; }
  .exhibit-media :global(.mission-film) { margin: 0; border: 0; }
  .exhibit-media :global(.explode > .view) { height: clamp(420px, 48vw, 650px); }
  .exhibit-media :global(.mechanism > .media-view) { height: clamp(380px, 36vw, 480px); }
  .exhibit-media :global(.mechanism .states) { flex-wrap: wrap; }
  .exhibit-footer { margin-top: 1rem; border-bottom: 1px solid var(--rule); padding-bottom: 1rem; }
  .specs { display: flex; flex-wrap: wrap; gap: 1rem 2.5rem; margin: 0 0 1rem; }
  .specs dt { color: var(--ink-3); font-size: var(--t-xs); }
  .specs dd { margin: .2rem 0 0; color: var(--ink); font-size: 1.65rem; line-height: 1.3; }
  .unit { margin-left: .3rem; color: var(--ink-2); font-size: var(--t-xs); }
  summary { width: fit-content; padding: .4rem 0; color: var(--ink-2); cursor: pointer; font-size: var(--t-sm); }
  summary:hover { color: var(--amber); }
  .detail-body { max-width: 75ch; color: var(--ink-2); font-size: var(--t-sm); padding: .5rem 0; }
  .detail-body p { margin: .4rem 0; }
  ul { padding-left: 1.2rem; }
  li + li { margin-top: .5rem; }
  .image { width: 100%; height: 400px; border: 0; padding: 2rem; cursor: zoom-in; background: var(--panel); }
  .image.light { background: var(--plate); }
  .image :global(img) { width: 100%; height: 100%; object-fit: contain; }
  .image.light :global(img) { mix-blend-mode: multiply; }
  .compact .exhibit-heading { display: block; min-height: 6.5rem; }
  .compact h2 { font-size: clamp(1.8rem, 2.4vw, 2.4rem); }
  .compact .exhibit-heading p { max-width: none; margin-top: .8rem; }
  .compact .exhibit-media :global(.mechanism > .media-view) { height: 400px; }
  @media(max-width: 1000px) {
    .exhibit-heading { display: block; }
    .exhibit-heading p { max-width: none; margin-top: .8rem; }
    .compact .exhibit-heading { min-height: 0; }
  }
  @media(max-width: 600px) {
    .exhibit-media :global(.explode > .view) { height: 360px; }
    .image, .compact .exhibit-media :global(.mechanism > .media-view) { height: 320px; }
    .specs { gap: 1rem 1.5rem; }
  }
</style>
