---
import { Image } from 'astro:assets';
import ModuleMedia from './ModuleMedia.astro';
import { engineer, engineerShowcase as copy, sceneCopy, type Chapter } from '../data/content';
import { t, ui, type Lang } from '../data/i18n';
interface Props { lang: Lang; chapter: Chapter; compact?: boolean; flip?: boolean }
const { lang, chapter: c, compact = false, flip = false } = Astro.props;
const sentence = copy.chapters[c.id as keyof typeof copy.chapters];
// Right-hand frame tag: what the viewer is actually looking at.
const model = c.pics?.find(p => p.model)?.model;
const medium = c.id === 'layout' ? '1080P · 30 FPS · SIM' : c.id === 'arm' ? '3D · arm-parts.glb' : model ? `3D · ${model}` : 'CAD';
---
<section class:list={['exhibit', { compact, flip }]} id={c.id} aria-labelledby={`${c.id}-title`}>
  <header class="exhibit-heading" data-hud-reveal>
    <span class="mark" aria-hidden="true">{c.mark}</span>
    <h2 class="display" id={`${c.id}-title`}>{t(c.title, lang)}</h2>
    <span class="ruler" aria-hidden="true"></span>
    <p>{t(sentence, lang)}</p>
  </header>
  <div class="stage">
    <div class="hud-tag" aria-hidden="true"><span><b>{engineer.drawing}</b> / FIG.{c.mark}</span><span class="file">{medium}</span></div>
    <div class="exhibit-media hud-frame">
      <slot />
      {c.pics?.map(pic => pic.model ? <ModuleMedia pic={pic} lang={lang} concise /> : (
        <button class:list={['image blueprint', { light: pic.light || pic.cutout }]} type="button" data-zoom={pic.src.src} data-alt={t(pic.alt, lang)} aria-label={`${t(ui.enlarge, lang)}: ${t(pic.alt, lang)}`}>
          <Image src={pic.src} alt={t(pic.alt, lang)} widths={[480, 900, 1400]} sizes="(max-width: 1000px) 100vw, 60vw" />
        </button>
      ))}
    </div>
  </div>
  <div class="exhibit-footer" data-hud-reveal>
    {c.specs && <dl class="hud-readout">{c.specs.map(s => <div>
      <dt>{t(s.label, lang)}{s.note && <span> · {t(s.note, lang)}</span>}</dt>
      <dd><span data-count-up>{s.value}</span><span class="unit">{s.unit}</span></dd>
    </div>)}</dl>}
    <details class="design-details">
      <summary>{t(copy.designDetails, lang)}</summary>
      <div class="detail-body">
        {c.lede && <p>{t(c.lede, lang)}</p>}
        {c.bullets && <ul>{c.bullets.map(b => <li>{t(b, lang)}</li>)}</ul>}
        {c.id === 'chassis' && <p>{t(sceneCopy.swerve.sensorNote, lang)}</p>}
      </div>
    </details>
  </div>
</section>
<style>
  .exhibit { min-width: 0; padding-top: clamp(4rem, 8vw, 7rem); scroll-margin-top: 6rem; }
  /* Heading: boxed letter, title, one-line verdict, then a ticked ruler that draws in. */
  .exhibit-heading { display: grid; grid-template-columns: auto minmax(0, 1fr) auto; grid-template-areas: 'mark title verdict' 'ruler ruler ruler'; align-items: center; gap: 0 1.1rem; margin-bottom: 1.5rem; }
  .mark { grid-area: mark; display: grid; place-items: center; width: 2.4rem; height: 2.4rem; border: 1px solid var(--amber); color: var(--amber); font: 500 1.15rem var(--f-mono); }
  h2 { grid-area: title; margin: 0; font-size: clamp(1.9rem, 3.1vw, 3rem); text-wrap: balance; }
  .exhibit-heading p { grid-area: verdict; margin: 0; max-width: 30ch; color: var(--ink-2); font-size: var(--t-sm); text-align: right; }
  .ruler { grid-area: ruler; height: 10px; margin-top: 1rem; background: var(--ruler); transform-origin: left; transition: transform .7s cubic-bezier(.2, .7, .2, 1); }
  :global(.hud-js) .exhibit-heading:not(.is-in) .ruler { transform: scaleX(0); }
  .stage { min-width: 0; }
  .exhibit-media { min-width: 0; }
  .exhibit-media :global(.mission-film) { margin: 0; border: 0; }
  .exhibit-media :global(.explode > .view) { height: clamp(440px, 46vw, 640px); }
  .exhibit-media :global(.mechanism > .media-view) { height: clamp(380px, 36vw, 480px); }
  .exhibit-media :global(.mechanism .states) { flex-wrap: wrap; }
  .exhibit-footer { margin-top: 1.25rem; }
  .hud-readout { margin-bottom: .4rem; }
  summary { width: fit-content; padding: .5rem 0; color: var(--ink-2); cursor: pointer; font-size: var(--t-sm); }
  summary::marker { color: var(--amber); }
  summary:hover { color: var(--amber); }
  .detail-body { max-width: 75ch; color: var(--ink-2); font-size: var(--t-sm); padding: .5rem 0; }
  .detail-body p { margin: .4rem 0; }
  ul { padding-left: 1.2rem; }
  li + li { margin-top: .5rem; }
  .image { display: block; width: 100%; height: 440px; border: 0; padding: 2rem; cursor: zoom-in; }
  .image.light { background: var(--plate); }
  .image :global(img) { width: 100%; height: 100%; object-fit: contain; }
  .image.light :global(img) { mix-blend-mode: multiply; }
  /* Supporting modules: media ~62% beside a vertical readout column, sides alternate. */
  .compact { display: grid; grid-template-columns: minmax(0, 1.62fr) minmax(0, 1fr); grid-template-areas: 'stage head' 'stage foot'; grid-template-rows: auto 1fr; gap: 0 clamp(2rem, 4vw, 3.5rem); }
  .compact.flip { grid-template-columns: minmax(0, 1fr) minmax(0, 1.62fr); grid-template-areas: 'head stage' 'foot stage'; }
  .compact .stage { grid-area: stage; }
  .compact .exhibit-heading { grid-area: head; grid-template-columns: auto minmax(0, 1fr); grid-template-areas: 'mark title' 'ruler ruler' 'verdict verdict'; align-self: start; margin: 1.6rem 0 0; }
  .compact h2 { font-size: clamp(1.8rem, 2.5vw, 2.5rem); }
  .compact .exhibit-heading p { text-align: left; max-width: none; margin-top: 1rem; font-size: var(--t-md); color: var(--ink); }
  .compact .exhibit-footer { grid-area: foot; margin-top: 1.5rem; }
  .compact .hud-readout { flex-direction: column; border-top: 0; }
  .compact .hud-readout > div { margin: 0; padding: .8rem 0; border-right: 0; border-top: 1px solid var(--rule-soft); }
  .compact .hud-readout > div:last-child { border-bottom: 1px solid var(--rule-soft); }
  .compact .exhibit-media :global(.mechanism > .media-view) { height: clamp(400px, 38vw, 520px); }
  .compact .image { height: clamp(400px, 38vw, 520px); }
  @media(max-width: 1000px) {
    .exhibit-heading, .compact .exhibit-heading { grid-template-columns: auto minmax(0, 1fr); grid-template-areas: 'mark title' 'ruler ruler' 'verdict verdict'; }
    .exhibit-heading p { text-align: left; max-width: none; margin-top: .9rem; }
    .compact, .compact.flip { display: block; }
    .compact .exhibit-heading { margin: 0 0 1.5rem; }
  }
  @media(max-width: 600px) {
    .exhibit-media :global(.explode > .view) { height: 360px; }
    .image, .compact .image, .compact .exhibit-media :global(.mechanism > .media-view) { height: 320px; }
    .hud-readout > div { padding-right: 1.2rem; margin-right: 1.2rem; }
  }
</style>
