---
// DEV ONLY (not linked): tune the folded / extended key poses for the arm scene.
import '../../styles/global.css';
---
<html lang="en">
  <body style="margin:0">
    <canvas id="c" style="width:960px;height:640px;display:block"></canvas>
    <pre id="o" style="color:#e7eef6"></pre>
    <script>
      import { loadArmScene } from '../../scripts/arm-scene';
      const s = await loadArmScene(document.getElementById('c') as HTMLCanvasElement, import.meta.env.BASE_URL);
      (window as any).__arm = s;
      s.setScan(1);
      const m = s.render();
      document.getElementById('o')!.textContent = 'ready ' + JSON.stringify(m);
    </script>
  </body>
</html>
